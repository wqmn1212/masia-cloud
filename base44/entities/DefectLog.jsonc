{
  "name": "DefectLog",
  "type": "object",
  "required": [
    "card_id",
    "defect_type"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID"
    },
    "card_id": {
      "type": "string",
      "description": "\ubd88\ub7c9\uc774 \ub09c \uce74\ub4dc"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac ID"
    },
    "factory_id": {
      "type": "string",
      "description": "\uacf5\uc7a5 ID (\uce74\ub4dc\uc758 factory_id)"
    },
    "card_title": {
      "type": "string",
      "description": "\uae30\ub85d\ud560 \ub54c\uc758 \uce74\ub4dc \uc81c\ubaa9 (\ucc3e\uae30\uc6a9)"
    },
    "occurred_date": {
      "type": "string",
      "description": "\ubd88\ub7c9\uc774 \ub09c \ub0a0 YYYY-MM-DD"
    },
    "stage": {
      "type": "string",
      "description": "\uc5b4\ub5a4 \uc791\uc5c5 \uc911\uc774\uc5c8\ub098 (\uc608: \uc591\uc0b0 \uac80\uc0ac, \uc2a4\ud2f0\ucee4 \ubd80\ucc29, \ud3ec\uc7a5, \uc785\uace0 \uac80\uc0ac)"
    },
    "defect_type": {
      "type": "string",
      "description": "\ubd88\ub7c9 \ub0b4\uc6a9 (\uc608: RF \uc5f4\uac10 \ucd9c\ub825, \uc2a4\ud2f0\ucee4 \uc808\ucde8\uc120 \ucc22\uc5b4\uc9d0)"
    },
    "description": {
      "type": "string",
      "description": "\uc790\uc138\ud55c \ub0b4\uc6a9\u00b7\uc6d0\uc778\u00b7\uc870\uce58"
    },
    "kind": {
      "type": "string",
      "description": "\uc81c\ud488 \ubd88\ub7c9 / \uc2a4\ud2f0\ucee4 \ubd88\ub7c9 / \ud3ec\uc7a5 \ubd88\ub7c9 / \uae30\ud0c0",
      "enum": [
        "PRODUCT",
        "STICKER",
        "PACKAGING",
        "OTHER"
      ]
    },
    "qty": {
      "type": "number",
      "description": "\ubd88\ub7c9 \uc218\ub7c9"
    },
    "serials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ubd88\ub7c9 \uc2dc\ub9ac\uc5bc"
    },
    "serial_range": {
      "type": "string",
      "description": "\uc2dc\ub9ac\uc5bc \ubc94\uc704 \uc694\uc57d"
    },
    "source": {
      "type": "string",
      "description": "\uc5b4\ub514\uc11c \uc654\ub098: AI \ube44\uc11c \uc5d1\uc140 / \uac80\uc0ac \uc131\uc801\uc11c / \uc9c1\uc811 \uc785\ub825",
      "enum": [
        "ASSISTANT",
        "INSPECTION",
        "MANUAL"
      ]
    },
    "source_file": {
      "type": "string",
      "description": "\uac00\uc838\uc628 \ud30c\uc77c \uc774\ub984"
    },
    "created_by_name": {
      "type": "string",
      "description": "\uae30\ub85d\ud55c \uc9c1\uc6d0"
    },
    "dedupe_key": {
      "type": "string",
      "description": "\uac19\uc740 \ud30c\uc77c\uc744 \ub450 \ubc88 \ub123\uc9c0 \uc54a\uae30 \uc704\ud55c \ud0a4"
    }
  },
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}
