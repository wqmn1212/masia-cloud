{
  "name": "Company",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "CLIENT",
        "FACTORY"
      ]
    },
    "company_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "factory_address": {
      "type": "string"
    },
    "annual_revenue": {
      "type": "number"
    },
    "employee_count": {
      "type": "number"
    },
    "establishment_date": {
      "type": "string",
      "format": "date"
    },
    "contact_person": {
      "type": "string"
    },
    "wechat_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "business_registration_url": {
      "type": "string"
    },
    "memo": {
      "type": "string"
    },
    "remittance_documents": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "file_name",
          "file_uri"
        ]
      }
    },
    "verification_items": {
      "type": "object",
      "description": "\uacf5\uc7a5 \ud655\uc778 \uce74\ub4dc \ud56d\ubaa9\ubcc4 \uacb0\uacfc {\ud0a4: {status: OK|NG|NA, note}}. \ud0a4\ub294 LICENSE\u00b7SCOPE\u00b7MANUFACTURER\u00b7SITE_VISIT\u00b7EQUIPMENT"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "NONE",
        "PARTIAL",
        "VERIFIED",
        "FLAGGED"
      ],
      "description": "\uacf5\uc7a5 \ud655\uc778 \uacb0\uacfc \uc694\uc57d. VERIFIED \uc5ec\uc57c \uc0dd\uc0b0 \ucc29\uc218 \uac00\ub2a5, FLAGGED \ub294 \ubb38\uc81c \ud56d\ubaa9 \uc788\uc74c"
    },
    "verification_visited_at": {
      "type": "string",
      "description": "\uacf5\uc7a5 \ud604\uc7a5 \ubc29\ubb38\uc77c YYYY-MM-DD"
    },
    "verification_checked_by_name": {
      "type": "string"
    },
    "verification_updated_at": {
      "type": "string"
    },
    "cn_trademark_status": {
      "type": "string",
      "enum": [
        "REGISTERED",
        "APPLIED",
        "NOT_FILED",
        "UNKNOWN"
      ],
      "description": "\uace0\uac1d\uc0ac \ube0c\ub79c\ub4dc\uc758 \uc911\uad6d \uc0c1\ud45c \ub4f1\ub85d \uc0c1\ud0dc (\uacf5\uc7a5\uc758 \uc0c1\ud45c \uc120\uc810 \ubc29\uc9c0)"
    },
    "cn_trademark_note": {
      "type": "string"
    }
  },
  "required": [
    "company_type",
    "company_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}