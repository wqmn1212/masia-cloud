{
  "name": "SocialConnection",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "youtube"
      ]
    },
    "account_name": {
      "type": "string",
      "description": "\uacc4\uc815 \ud45c\uc2dc\uba85 / \ud578\ub4e4"
    },
    "account_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_connected",
        "manual",
        "connected"
      ],
      "default": "manual"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "platform"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}