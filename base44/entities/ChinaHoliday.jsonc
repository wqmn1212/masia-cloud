{
  "name": "ChinaHoliday",
  "type": "object",
  "properties": {
    "year": {
      "type": "number",
      "description": "\uc5f0\ub3c4"
    },
    "name": {
      "type": "string",
      "description": "\ud734\uc77c\uba85 (\uc608: \ucd98\uc808)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\uacf5\uc2dd \ud734\uc77c \uc2dc\uc791"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\uacf5\uc2dd \ud734\uc77c \uc885\ub8cc"
    },
    "makeup_workdays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\uc870\ud734 \uadfc\ubb34\uc77c (\uc8fc\ub9d0\uc778\ub370 \uc77c\ud558\ub294 \ub0a0)"
    },
    "order_cutoff_date": {
      "type": "string",
      "format": "date",
      "description": "\ud734\uc77c \uc804 \ucd9c\uace0 \ubc1c\uc8fc \ub9c8\uac10\uc77c"
    },
    "factory_extra_days": {
      "type": "number",
      "default": 0,
      "description": "\uacf5\uc7a5\uc774 \uacf5\ud734\uc77c \uc55e\ub4a4\ub85c \ub354 \uc26c\ub294 \uc77c\uc218"
    },
    "announce": {
      "type": "boolean",
      "default": false,
      "description": "\uace0\uac1d\uc5d0\uac8c \ubc1c\uc8fc \ub9c8\uac10 \uc548\ub0b4 \ubc1c\uc1a1"
    },
    "notice_sent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ubc1c\uc1a1\ub41c \uc548\ub0b4 \uc2dc\uc810 (30, 7)"
    }
  },
  "required": [
    "year",
    "name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "user_condition": {
            "data.account_tier": "service"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "user_condition": {
            "data.account_tier": "service"
          }
        },
        {
          "user_condition": {
            "data.account_tier": "sub"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "user_condition": {
            "data.account_tier": "service"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "user_condition": {
            "data.account_tier": "service"
          }
        }
      ]
    }
  }
}