{
  "name": "OperationSetting",
  "type": "object",
  "description": "\ud300 \uc6b4\uc601 \uae30\uc900\uac12. \ud14c\ub10c\ud2b8\ub2f9 1\uac74. \uc6d0\uac00\u00b7\uc218\uc6a9 \ud55c\ub3c4\u00b7\uac00\ub3d9\ub960 \uac00\uc911\uce58\u00b7\uc789\uc5ec \ubc30\ubd84 \ube44\uc728\uc744 \ub2f4\ub294\ub2e4.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4). \ud14c\ub10c\ud2b8\ub2f9 1\uac74"
    },
    "team_monthly_cost": {
      "type": "number",
      "default": 6000000,
      "description": "\ud300 \uc6d4 \uc6d0\uac00 (\ud55c\uad6d 1\uba85 400\ub9cc + \uc911\uad6d 2\uba85 \uac01 100\ub9cc \uae30\uc900). \uc778\ub825 \ubcc0\ub3d9 \uc2dc \uc870\uc815"
    },
    "capacity_limit": {
      "type": "number",
      "default": 10,
      "description": "\ud300 \uc218\uc6a9 \ud55c\ub3c4. \ubc30\uc815 \uce74\ub4dc\uc758 \ub2e8\uacc4\ubcc4 \uac00\uc911\uce58 \ud569\uacc4 \uc0c1\ud55c"
    },
    "status_weights": {
      "type": "array",
      "description": "\uce74\ub4dc \uc0c1\ud0dc\ubcc4 \uc5c5\ubb34 \ubd80\ud558 \uac00\uc911\uce58. \uc6b4\uc601\ud558\uba70 \uc870\uc815\ud55c\ub2e4",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "REVIEW",
              "PRODUCTION",
              "DONE",
              "CANCELLED"
            ]
          },
          "weight": {
            "type": "number"
          }
        }
      }
    },
    "owner_share_percent": {
      "type": "number",
      "default": 50,
      "description": "\uc6d4 \uc789\uc5ec \uc911 \ub300\ud45c \ubaab \ube44\uc728 (%). \ub098\uba38\uc9c0\ub294 \ud300\uc6d0 \ubc30\ubd84"
    },
    "updated_by": {
      "type": "string",
      "description": "\ucd5c\uc885 \uc218\uc815\uc790"
    },
    "signature_rep_name": {
      "type": "string",
      "description": "\uc804\uc790\uc11c\uba85 \uc774\uc9c0\uc2a4 \uc11c\uba85\uc790 \uc774\ub984 (\ub300\ud45c)"
    },
    "signature_rep_title": {
      "type": "string",
      "description": "\uc11c\uba85\uc790 \uc9c1\ucc45"
    },
    "signature_company": {
      "type": "string",
      "description": "\uc11c\uba85 \ud68c\uc0ac\uba85"
    },
    "signature_seal_uri": {
      "type": "string",
      "description": "\uc774\uc9c0\uc2a4 \uc9c1\uc778 \uc774\ubbf8\uc9c0 (\ube44\uacf5\uac1c, \ub9c8\uc2a4\ud130\ub9cc \ubcc0\uacbd)"
    },
    "signature_seal_updated_at": {
      "type": "string",
      "description": "\uc9c1\uc778 \ubcc0\uacbd \uc2dc\uac01"
    },
    "signature_seal_updated_by": {
      "type": "string",
      "description": "\uc9c1\uc778 \ubcc0\uacbd\uc790"
    },
    "client_show_pm": {
      "type": "boolean",
      "default": false,
      "description": "\uace0\uac1d \ud3ec\ud138 \uce74\ub4dc\uc5d0 \ub2f4\ub2f9 PM \uc774\ub984(\uce74\ub4dc \ucc45\uc784\uc790)\uc744 \ubcf4\uc5ec \uc904\uc9c0. \uae30\ubcf8\uc740 \uc228\uae40"
    },
    "client_reply_hours": {
      "type": "string",
      "description": "\uace0\uac1d \ud654\uba74\uc5d0 \ubcf4\uc77c \ub2f5\ubcc0 \uac00\ub2a5 \uc2dc\uac04 (\uc608: \ud3c9\uc77c 10:00~18:00, \ud55c\uad6d \uc2dc\uac04)"
    },
    "factory_approval_requires_client": {
      "type": "boolean",
      "default": false,
      "description": "\uace0\uac1d \ud655\uc778\uc744 \uc694\uccad\ud55c \ud30c\uc77c\uc740 \uace0\uac1d\uc774 \uc2b9\uc778\ud55c \ud310\ub9cc \uacf5\uc7a5 \uc804\ub2ec \uc2b9\uc778\ubcf8\uc73c\ub85c \uc9c0\uc815\ud560 \uc218 \uc788\uac8c \ud560\uc9c0"
    },
    "margin_default_pct": {
      "type": "number",
      "description": "\uacac\uc801 \uae30\uc900 \ub9c8\uc9c4 % (\ud300 \uae30\ubcf8). \ube44\uc6b0\uba74 \uc571 \uae30\ubcf8 15%"
    },
    "margin_min_pct": {
      "type": "number",
      "description": "\uacac\uc801 \ucd5c\uc18c \ub9c8\uc9c4 % (\ud300 \uae30\ubcf8). \uc774\ubcf4\ub2e4 \ub0ae\uc73c\uba74 \uc2b9\uc778 \ub54c \uc8fc\uc758. \ube44\uc6b0\uba74 \uc571 \uae30\ubcf8 10%"
    },
    "margin_rules": {
      "type": "array",
      "description": "\uace0\uac1d\uc0ac\u00b7\uce74\ud14c\uace0\ub9ac\ubcc4 \ub9c8\uc9c4 \uaddc\uce59 (\uace0\uac1d\uc0ac \u2192 \uce74\ud14c\uace0\ub9ac \u2192 \ud300 \uae30\ubcf8 \uc21c\uc73c\ub85c \uc801\uc6a9)",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "CLIENT",
              "CATEGORY"
            ]
          },
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "default_pct": {
            "type": "number"
          },
          "min_pct": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "intake_default_owner_id": {
      "type": "string",
      "description": "\uc0c8 \ubb38\uc758 \ud300 \uae30\ubcf8 \ub2f4\ub2f9\uc790 (\uaddc\uce59\uc5d0 \ub9de\ub294 \uc0ac\ub78c\uc774 \uc5c6\uc744 \ub54c)"
    },
    "intake_default_owner_name": {
      "type": "string"
    },
    "quote_sla_days": {
      "type": "number",
      "description": "\uc0c8 \ubb38\uc758 \uacac\uc801 \uae30\ud55c (\uc601\uc5c5\uc77c). \ube44\uc6b0\uba74 3"
    },
    "quote_rush_window_days": {
      "type": "number",
      "description": "\ud76c\ub9dd \uc785\uace0\uc77c\uc774 \uc774 \uc77c\uc218 \uc548\uc774\uba74 \uae09\ud55c \ubb38\uc758 (\uacac\uc801 \uae30\ud55c \ub2e4\uc74c \uc601\uc5c5\uc77c, \uc6b0\uc120\uc21c\uc704 \ub192\uc74c). \ube44\uc6b0\uba74 30, 0\uc774\uba74 \ub054"
    },
    "intake_rules": {
      "type": "array",
      "description": "\uc0c8 \ubb38\uc758 \ubc30\uc815 \uaddc\uce59 (\uace0\uac1d\uc0ac \u2192 \uce74\ud14c\uace0\ub9ac \u2192 \ud300 \uae30\ubcf8 \ub2f4\ub2f9\uc790)",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "CLIENT",
              "CATEGORY"
            ]
          },
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "owner_name": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "tenant_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}
