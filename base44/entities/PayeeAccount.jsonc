{
  "name": "PayeeAccount",
  "type": "object",
  "description": "\uc774\uc9c0\uc2a4(\ud300)\uac00 \ub300\uae08\uc744 \ubc1b\ub294 \uacc4\uc88c. \uacc4\uc88c \uc0ac\uae30\ub97c \ub9c9\uae30 \uc704\ud574 \ub9c8\uc2a4\ud130\ub9cc \ub4f1\ub85d\u00b7\ubcc0\uacbd\ud558\uace0, \uace0\uac1d\uc740 \uacb0\uc81c \uc694\uccad\uc774 \uc788\uc744 \ub54c \uc11c\ubc84 \ud568\uc218\ub85c\ub9cc \ubcf8\ub2e4.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "label": {
      "type": "string",
      "description": "\ud45c\uc2dc \uc774\ub984 (\uc608: \uc774\uc9c0\uc2a4 USD \uacc4\uc88c)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "KRW",
        "USD",
        "CNY"
      ],
      "description": "\ubc1b\ub294 \ud1b5\ud654"
    },
    "bank_name": {
      "type": "string"
    },
    "account_holder": {
      "type": "string",
      "description": "\uc608\uae08\uc8fc"
    },
    "account_no": {
      "type": "string"
    },
    "swift_code": {
      "type": "string"
    },
    "bank_address": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "description": "\uace0\uac1d\uc5d0\uac8c \ubcf4\uc774\ub294 \uc548\ub0b4 (\uc608: \uc1a1\uae08 \uba54\ubaa8\uc5d0 \ud504\ub85c\uc81d\ud2b8\uba85 \uae30\uc7ac)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\ub044\uba74 \uc0c8 \uacb0\uc81c \uc694\uccad\uc5d0 \uace0\ub97c \uc218 \uc5c6\ub2e4"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "currency",
    "bank_name",
    "account_holder",
    "account_no"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}