{
  "name": "GroupIssue",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "소속 팀 ID"
    },
    "group_id": {
      "type": "string",
      "description": "CardGroup ID"
    },
    "card_id": {
      "type": "string",
      "description": "관련 카드 (선택)"
    },
    "no": {
      "type": "number",
      "description": "그룹 안 일련번호"
    },
    "area": {
      "type": "string",
      "description": "부위·공정 (예: 헤드 PCB, 배터리)"
    },
    "title": {
      "type": "string",
      "description": "문제점"
    },
    "detail": {
      "type": "string",
      "description": "세부 내용·현장 메모"
    },
    "cause": {
      "type": "string",
      "description": "원인 구분"
    },
    "vendor": {
      "type": "string",
      "description": "관련 업체"
    },
    "impact": {
      "type": "string",
      "description": "영향"
    },
    "action_plan": {
      "type": "string",
      "description": "개선 방안·수정 요청"
    },
    "severity": {
      "type": "string",
      "enum": [
        "HIGH",
        "MID",
        "LOW"
      ],
      "default": "MID"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CHECK",
        "DOING",
        "TEMP",
        "DONE"
      ],
      "default": "OPEN",
      "description": "미조치·확인 필요·조치 중·임시 조치·완료"
    },
    "assignee_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "done_date": {
      "type": "string",
      "format": "date"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "description": "사진 (문제점 옆에 보여 줌)"
    },
    "related_doc": {
      "type": "string",
      "description": "관련 문서·작업지도서"
    },
    "source": {
      "type": "string",
      "enum": [
        "ASSEMBLY",
        "WORK_INSTRUCTION",
        "SPEC",
        "MEETING",
        "MANUAL"
      ],
      "default": "MANUAL",
      "description": "어디서 나온 이슈인가"
    },
    "source_file": {
      "type": "string",
      "description": "가져온 엑셀 파일 이름"
    },
    "import_key": {
      "type": "string",
      "description": "같은 줄을 두 번 가져오지 않기 위한 키"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "변경 이력"
    },
    "created_by_name": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "group_id",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}
