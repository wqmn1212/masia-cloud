{
  "name": "Shipment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c \ud0dc\uc2a4\ud06c \uce74\ub4dc ID"
    },
    "label": {
      "type": "string",
      "description": "\uc120\uc801 \uc774\ub984 (\uc608: 1\ucc28 \uc120\uc801)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "SEA_FCL",
        "SEA_LCL",
        "AIR",
        "EXPRESS",
        "RAIL",
        "TRUCK"
      ],
      "description": "\uc6b4\uc1a1 \ubc29\uc2dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "PREPARING",
        "BOOKED",
        "DEPARTED",
        "ARRIVED",
        "CUSTOMS",
        "CLEARED",
        "DELIVERED",
        "ON_HOLD"
      ],
      "default": "PREPARING",
      "description": "\uc120\uc801 \uc9c4\ud589 \uc0c1\ud0dc"
    },
    "forwarder": {
      "type": "string",
      "description": "\ud3ec\uc6cc\ub354 (\ub0b4\ubd80\uc6a9)"
    },
    "carrier": {
      "type": "string",
      "description": "\uc120\uc0ac\u00b7\ud56d\uacf5\uc0ac\u00b7\ud2b9\uc1a1\uc0ac"
    },
    "tracking_no": {
      "type": "string",
      "description": "B/L \u00b7 AWB \u00b7 \uc6b4\uc1a1\uc7a5 \ubc88\ud638"
    },
    "port_from": {
      "type": "string",
      "description": "\ucd9c\ubc1c\ud56d\u00b7\uacf5\ud56d"
    },
    "port_to": {
      "type": "string",
      "description": "\ub3c4\ucc29\ud56d\u00b7\uacf5\ud56d"
    },
    "etd": {
      "type": "string",
      "description": "\ucd9c\ud56d \uc608\uc815\uc77c YYYY-MM-DD"
    },
    "eta": {
      "type": "string",
      "description": "\ub3c4\ucc29 \uc608\uc815\uc77c YYYY-MM-DD"
    },
    "atd": {
      "type": "string",
      "description": "\uc2e4\uc81c \ucd9c\ud56d\uc77c"
    },
    "ata": {
      "type": "string",
      "description": "\uc2e4\uc81c \ub3c4\ucc29\uc77c"
    },
    "dangerous_goods": {
      "type": "boolean",
      "default": false,
      "description": "\ubc30\ud130\ub9ac \ub4f1 \uc704\ud5d8\ubb3c \ud3ec\ud568. \ucf1c\uba74 UN38.3\u00b7MSDS\u00b7\ubc30\ud130\ub9ac \uc0ac\uc591\uc11c\u00b7\uc704\ud5d8\ubb3c \uc2e0\uace0\uc11c\uac00 \ud544\uc218 \uc11c\ub958\uac00 \ub41c\ub2e4"
    },
    "docs": {
      "type": "array",
      "description": "\uc11c\ub958 \uccb4\ud06c\ub9ac\uc2a4\ud2b8",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "COMMERCIAL_INVOICE",
              "PACKING_LIST",
              "BILL_OF_LADING",
              "CERT_ORIGIN",
              "UN38_3",
              "MSDS",
              "BATTERY_SPEC",
              "DG_DECLARATION",
              "OTHER"
            ],
            "description": "\uc11c\ub958 \uc885\ub958"
          },
          "status": {
            "type": "string",
            "enum": [
              "MISSING",
              "READY",
              "NA"
            ],
            "description": "\uc900\ube44 \uc0c1\ud0dc"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "package_note": {
      "type": "string",
      "description": "\ubc15\uc2a4 \uc218\u00b7\uc911\ub7c9\u00b7\ubd80\ud53c"
    },
    "client_note": {
      "type": "string",
      "description": "\uace0\uac1d\uc5d0\uac8c \ubcf4\uc774\ub294 \uc548\ub0b4 \uba54\ubaa8"
    },
    "note": {
      "type": "string",
      "description": "\ub0b4\ubd80 \uba54\ubaa8 (\uace0\uac1d \ube44\uacf5\uac1c)"
    },
    "client_visible": {
      "type": "boolean",
      "default": true,
      "description": "\uace0\uac1d \ud3ec\ud138 \uacf5\uac1c \uc5ec\ubd80"
    },
    "status_updated_at": {
      "type": "string",
      "description": "\uc0c1\ud0dc\ub97c \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ubc14\uafbc \uc2dc\uac01"
    },
    "docs_warned_for": {
      "type": "string",
      "description": "\uc11c\ub958 \ubbf8\ube44 \uacbd\uace0\ub97c \ubcf4\ub0b8 \uae30\uc900 (etd:\ub2e8\uacc4). \uac19\uc740 \ucd9c\ud56d\uc77c\ub85c \ubc18\ubcf5 \uacbd\uace0\ud558\uc9c0 \uc54a\ub294\ub2e4"
    },
    "dest_cost_input": {
      "type": "object",
      "description": "\ub3c4\ucc29\uc9c0 \ube44\uc6a9 \uacc4\uc0b0\uc5d0 \ub123\uc740 \uac12 (\ub0b4\ubd80\uc6a9, \ub2e4\uc2dc \uacc4\uc0b0\ud560 \ub54c \ubd88\ub7ec\uc634)"
    },
    "dest_cost_estimate": {
      "type": "object",
      "description": "\ud55c\uad6d\uc5d0\uc11c \ub530\ub85c \ub0bc \ub3c8 \uc608\uc0c1 (\uacc4\uc0b0 \uc2dc\uc810 \uace0\uc815\ubcf8). \uace0\uac1d\uc774 \ud655\uc778\ud55c \uae08\uc561\uc774 \uc694\uc728\uc774 \ubc14\ub00c\uc5b4\ub3c4 \uadf8\ub300\ub85c \ub0a8\ub294\ub2e4"
    },
    "dest_cost_sent_at": {
      "type": "string",
      "description": "\uace0\uac1d\uc5d0\uac8c \ud655\uc778\uc744 \uc694\uccad\ud55c \uc2dc\uac01. \ube44\uc5b4 \uc788\uc73c\uba74 \uace0\uac1d\uc5d0\uac8c \ubcf4\uc774\uc9c0 \uc54a\ub294\ub2e4"
    },
    "dest_cost_sent_by_name": {
      "type": "string"
    },
    "dest_cost_decision": {
      "type": "string",
      "enum": [
        "ACKNOWLEDGED",
        "QUESTION",
        "PENDING"
      ],
      "description": "\uace0\uac1d \uc751\ub2f5: \ud655\uc778\ud568 \ub610\ub294 \ubb38\uc758. \ub2e4\uc2dc \ubcf4\ub0b4\uba74 \ube44\uc6b4\ub2e4"
    },
    "dest_cost_decided_at": {
      "type": "string"
    },
    "dest_cost_decided_by_name": {
      "type": "string"
    },
    "dest_cost_client_note": {
      "type": "string",
      "description": "\uace0\uac1d \ubb38\uc758 \ub0b4\uc6a9"
    },
    "dest_cost_actual": {
      "type": "number",
      "description": "\ub3c4\ucc29 \ud6c4 \uc2e4\uc81c \uccad\uad6c\ub41c \ubcc4\ub3c4 \ube44\uc6a9 (\uc6d0, \ubd80\uac00\uc138 \uc81c\uc678)"
    },
    "dest_cost_actual_vat": {
      "type": "number",
      "description": "\uc2e4\uc81c \ub0a9\ubd80\ud55c \uc218\uc785 \ubd80\uac00\uc138 (\uc6d0)"
    },
    "dest_cost_actual_note": {
      "type": "string",
      "description": "\uc608\uc0c1\uacfc \ub2e4\ub978 \uc774\uc720 (\uace0\uac1d\uc5d0\uac8c \ubcf4\uc784)"
    },
    "dest_cost_warned_for": {
      "type": "string",
      "description": "\ub3c4\ucc29\uc9c0 \ube44\uc6a9 \ubbf8\ud655\uc778 \uacbd\uace0\ub97c \ubcf4\ub0b8 \uae30\uc900 (etd:\ub2e8\uacc4)"
    },
    "dest_cost_actual_by_name": {
      "type": "string",
      "description": "\uc2e4\uc81c \ube44\uc6a9\uc744 \uae30\ub85d\ud55c \uc0ac\ub78c (AI \ube44\uc11c \uae30\ub85d\uc740 '(AI \ube44\uc11c)' \ud45c\uc2dc)"
    },
    "dest_cost_actual_at": {
      "type": "string",
      "description": "\uc2e4\uc81c \ube44\uc6a9 \uae30\ub85d \uc2dc\uac01"
    },
    "dest_cost_actual_source": {
      "type": "string",
      "description": "\uadfc\uac70 (\uc815\uc0b0\uc11c \ud30c\uc77c\uba85 \ub4f1, \ub0b4\ubd80\uc6a9)"
    }
  },
  "required": [
    "card_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}
