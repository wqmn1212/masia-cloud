{
  "name": "QCReport",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c \ud0dc\uc2a4\ud06c \uce74\ub4dc ID"
    },
    "inspection_type": {
      "type": "string",
      "enum": [
        "SAMPLE",
        "MASS_PRODUCTION"
      ]
    },
    "inspector_id": {
      "type": "string"
    },
    "inspector_name": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "PENDING",
              "FAIL"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qc_result": {
      "type": "string",
      "enum": [
        "PASS",
        "CONDITIONAL_PASS",
        "FAIL"
      ]
    },
    "comments": {
      "type": "string"
    },
    "golden_compared": {
      "type": "boolean",
      "description": "\uae30\uc900 \uc0d8\ud50c\uacfc \ub098\ub780\ud788 \ube44\uad50\ud55c \uc0ac\uc9c4 \ud3ec\ud568"
    },
    "client_visible": {
      "type": "boolean",
      "default": false,
      "description": "고객 포털 공개 여부 (담당자가 공장 식별 정보를 확인한 뒤 켬다)"
    },
    "client_published_at": {
      "type": "string",
      "description": "고객에게 공개한 시각"
    },
    "client_decision": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "ON_HOLD"
      ],
      "description": "고객 출고 판단. 고객 전용 서버 함수(clientCardAction)로만 바뀐다. 비어 있으면 대기",
      "rls": {
        "write": {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      }
    },
    "client_decision_note": {
      "type": "string",
      "description": "고객이 남긴 보류 사유·의견",
      "rls": {
        "write": {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      }
    },
    "client_decided_at": {
      "type": "string",
      "description": "고객 판단 시각",
      "rls": {
        "write": {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      }
    },
    "client_decided_by_name": {
      "type": "string",
      "description": "판단한 고객 담당자 이름",
      "rls": {
        "write": {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      }
    }
  },
  "required": [
    "card_id",
    "inspection_type",
    "qc_result"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}