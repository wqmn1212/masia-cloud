{
  "name": "TaskCard",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "title": {
      "type": "string",
      "description": "\uc18c\uc2f1 \uc5c5\ubb34 \uc81c\ubaa9"
    },
    "title_cn": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "REVIEW",
        "PRODUCTION",
        "DONE",
        "CANCELLED"
      ]
    },
    "target_machine_category": {
      "type": "string",
      "enum": [
        "DRIP_BAG",
        "SLEEVE",
        "DESKTOP_LABELER",
        "TUBE_SEALER"
      ]
    },
    "client_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac Company ID"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "lead_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "landing_lead"
      ],
      "default": "manual"
    },
    "candidate_factory_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_factory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factory_name": {
      "type": "string"
    },
    "factory_id": {
      "type": "string"
    },
    "hq_requirements": {
      "type": "string"
    },
    "hq_requirements_cn": {
      "type": "string"
    },
    "agent_meeting_notes": {
      "type": "string"
    },
    "agent_meeting_notes_cn": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "quote_deadline": {
      "type": "string"
    },
    "advance_paid_date": {
      "type": "string"
    },
    "delivery_business_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "delivery_date": {
      "type": "string"
    },
    "delivery_date_mode": {
      "type": "string",
      "enum": [
        "AUTO",
        "MANUAL"
      ],
      "default": "AUTO"
    },
    "cn_manual": {
      "type": "boolean",
      "default": false,
      "description": "\uc911\uad6d\uc5b4 \uc218\ub3d9 \ud655\uc815 \u2014 \uc790\ub3d9 \ubc88\uc5ed \ub36e\uc5b4\uc4f0\uae30 \ubc29\uc9c0"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}