{
  "name": "TaskCard",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "service_agreement_id": {
      "type": "string",
      "description": "\uadc0\uc18d\ub41c \uc6d4 \uacc4\uc57d ServiceAgreement ID. \uac12\uc774 \uc5c6\uc73c\uba74 \ub9ac\ud14c\uc774\ub108 \uacc4\uc57d \uc678 \ub2e8\ubc1c \uc18c\uc2f1 \uac74"
    },
    "title": {
      "type": "string",
      "description": "\uc18c\uc2f1 \uc5c5\ubb34 \uc81c\ubaa9"
    },
    "title_cn": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "REVIEW",
        "PRODUCTION",
        "DONE",
        "CANCELLED"
      ]
    },
    "target_machine_category": {
      "type": "string",
      "enum": [
        "DRIP_BAG",
        "SLEEVE",
        "DESKTOP_LABELER",
        "TUBE_SEALER"
      ]
    },
    "client_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac Company ID"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "lead_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "landing_lead"
      ],
      "default": "manual"
    },
    "candidate_factory_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_factory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factory_name": {
      "type": "string"
    },
    "factory_id": {
      "type": "string"
    },
    "hq_requirements": {
      "type": "string"
    },
    "hq_requirements_cn": {
      "type": "string"
    },
    "agent_meeting_notes": {
      "type": "string"
    },
    "agent_meeting_notes_cn": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "quote_deadline": {
      "type": "string"
    },
    "advance_paid_date": {
      "type": "string"
    },
    "delivery_business_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "delivery_date": {
      "type": "string"
    },
    "delivery_date_mode": {
      "type": "string",
      "enum": [
        "AUTO",
        "MANUAL"
      ],
      "default": "AUTO"
    },
    "cn_manual": {
      "type": "boolean",
      "default": false,
      "description": "\uc911\uad6d\uc5b4 \uc218\ub3d9 \ud655\uc815 \u2014 \uc790\ub3d9 \ubc88\uc5ed \ub36e\uc5b4\uc4f0\uae30 \ubc29\uc9c0"
    },
    "owner_id": {
      "type": "string",
      "description": "\uce74\ub4dc \ucc45\uc784\uc790 User ID (\ub300\ud45c\u00b7\ud300 \uad00\ub9ac\uc790\ub9cc \uc9c0\uc815)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "$and": [
                {
                  "data.tenant_id": "{{user.data.tenant_id}}"
                },
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "owner_name": {
      "type": "string",
      "description": "\uce74\ub4dc \ucc45\uc784\uc790 \uc774\ub984",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "$and": [
                {
                  "data.tenant_id": "{{user.data.tenant_id}}"
                },
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "next_action": {
      "type": "string",
      "description": "\ub2e4\uc74c \ud560 \uc77c"
    },
    "next_action_due": {
      "type": "string",
      "format": "date",
      "description": "\ub2e4\uc74c \ud560 \uc77c \uae30\ud55c"
    },
    "milestone_template_id": {
      "type": "string",
      "description": "\ub9c8\uc77c\uc2a4\ud1a4 \ud15c\ud50c\ub9bf \ud0a4"
    },
    "plan_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uacc4\ud68d \ud655\uc815 \uc2dc\uc810"
    },
    "current_milestone_label": {
      "type": "string",
      "description": "\ud604\uc7ac \ub2e8\uacc4 (\ubcf4\ub4dc \ud45c\uc2dc)"
    },
    "current_milestone_label_cn": {
      "type": "string",
      "description": "\ud604\uc7ac \ub2e8\uacc4 \uc911\uad6d\uc5b4 (\ubcf4\ub4dc \ud45c\uc2dc)"
    },
    "delay_days": {
      "type": "number",
      "default": 0,
      "description": "\ub0a9\ud488 \ub2e8\uacc4 \uae30\uc900 \uc9c0\uc5f0 \uc77c\uc218"
    },
    "overdue_steps": {
      "type": "number",
      "default": 0,
      "description": "\uacc4\ud68d\uc77c\uc774 \uc9c0\ub09c \ubbf8\uc644\ub8cc \ub2e8\uacc4 \uc218 (\ub9e4\uc77c \uac31\uc2e0)"
    },
    "pre_milestone_schedule": {
      "type": "object",
      "description": "\ub9c8\uc77c\uc2a4\ud1a4 \uc0dd\uc131 \uc804 \ub0a9\ud488\uc77c\u00b7\ubc29\uc2dd (\ub2e4\uc2dc \ub9cc\ub4e4\uae30 \uc2dc \ubcf5\uc6d0)",
      "properties": {
        "delivery_date": {
          "type": "string"
        },
        "delivery_date_mode": {
          "type": "string"
        }
      }
    },
    "holiday_conflicts": {
      "type": "array",
      "description": "\uc0dd\uc0b0 \uae30\uac04\uacfc \uacb9\uce58\ub294 \ud734\ubb34 (\uc911\ubcf5 \uc54c\ub9bc \ubc29\uc9c0)",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "holiday",
              "closure"
            ]
          },
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "notified_at": {
            "type": "string"
          },
          "client_notified_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}