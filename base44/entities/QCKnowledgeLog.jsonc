{
  "name": "QCKnowledgeLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "target_category": {
      "type": "string",
      "enum": [
        "DRIP_BAG",
        "SLEEVE",
        "DESKTOP_LABELER",
        "TUBE_SEALER"
      ],
      "description": "\ub300\uc0c1 \uc7a5\ube44 \uce74\ud14c\uace0\ub9ac (\uc608\uc804 \uc7a5\ube44 4\uc885, \uc120\ud0dd). \uc0c8 \uc0ac\ub840\ub294 component_type \uc744 \uc4f4\ub2e4"
    },
    "factory_id": {
      "type": "string",
      "description": "\uad00\ub828 \uacf5\uc7a5 ID"
    },
    "issue_case": {
      "type": "string",
      "description": "\uacb0\ud568 \uc0ac\ub840\uba85"
    },
    "root_cause": {
      "type": "string",
      "description": "\uadfc\ubcf8 \uc6d0\uc778"
    },
    "solution_parameter": {
      "type": "string",
      "description": "\ud574\uacb0 \ud30c\ub77c\ubbf8\ud130/\uc0ac\uc591 (JSON \ud14d\uc2a4\ud2b8)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "description": "\uc2ec\uac01\ub3c4"
    },
    "component_type": {
      "type": "string",
      "enum": [
        "PAPER_BOX",
        "PRINTED",
        "PLASTIC_PACK",
        "CARTON",
        "INJECTION",
        "ELECTRONICS",
        "TEXTILE",
        "EQUIPMENT"
      ],
      "description": "\uad6c\uc131\ud488 \uc720\ud615 (\uc0ac\uc804 QC \uc810\uac80 \ud15c\ud50c\ub9bf\uacfc \uac19\uc740 \uac12)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\uc7ac\uc9c8\u00b7\ud0a4\uc6cc\ub4dc \ud0dc\uadf8 (\uc608: \ube44\ucf54\ud305\uc9c0, \uc2a4\ub178\uc6b0\uc9c0, \ud569\uc9c0, \uad18\uc120). \uc0ac\uc804 \uc810\uac80\uc774 \uac19\uc740 \ud0dc\uadf8\uc758 \uc0ac\ub840\ub97c \uba3c\uc800 \ubd99\uc778\ub2e4"
    },
    "trigger_decision": {
      "type": "string",
      "description": "\uc6d0\uc778\uc774 \ub41c \uc0ac\uc591 \uacb0\uc815 (\uc608: \uc2a4\ub178\uc6b0\uc9c0 156g\u2192180g, \ucd5c\uc885 2.6T)"
    },
    "preventable_stage": {
      "type": "string",
      "enum": [
        "SPEC",
        "MATERIAL",
        "SAMPLE",
        "PRODUCTION",
        "PRESHIP",
        "PACKING"
      ],
      "description": "\ub9c9\uc744 \uc218 \uc788\uc5c8\ub358 \ub2e8\uacc4"
    },
    "prevention": {
      "type": "string",
      "description": "\uc608\ubc29\ucc45 (\ub2e4\uc74c \ud504\ub85c\uc81d\ud2b8\uc5d0\uc11c \ubbf8\ub9ac \ud560 \uc77c)"
    },
    "card_id": {
      "type": "string",
      "description": "\ubc1c\uc0dd\ud55c \ud0dc\uc2a4\ud06c \uce74\ub4dc"
    }
  },
  "required": [
    "issue_case",
    "root_cause"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}
