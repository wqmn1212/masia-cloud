{
  "name": "CardAttachment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "uploader_name": {
      "type": "string"
    },
    "uploader_role": {
      "type": "string",
      "enum": [
        "HQ",
        "AGENT"
      ]
    },
    "ai_parsed_text": {
      "type": "string"
    },
    "ai_parse_status": {
      "type": "string",
      "enum": [
        "NONE",
        "PENDING",
        "DONE",
        "FAILED"
      ]
    },
    "document_type": {
      "type": "string",
      "enum": [
        "GENERAL",
        "INVOICE_CI",
        "INVOICE_PI",
        "PACKING_LIST",
        "QUOTATION",
        "REMITTANCE_ACCOUNT",
        "BILL_OF_LADING",
        "CERT_ORIGIN",
        "UN38_3",
        "MSDS",
        "BATTERY_SPEC",
        "DG_DECLARATION",
        "CLAIM_PHOTO",
        "MOLD_OWNERSHIP",
        "REMITTANCE_DOWN",
        "REMITTANCE_BALANCE",
        "REMITTANCE_INTERIM",
        "SPEC_SHEET",
        "TEST_REPORT",
        "CERTIFICATE",
        "LOGISTICS_INVOICE"
      ],
      "default": "GENERAL"
    },
    "source_bank_document_id": {
      "type": "string"
    },
    "factory_approved": {
      "type": "boolean",
      "description": "\uacf5\uc7a5 \uc804\ub2ec \uc2b9\uc778\ubcf8 (\uacf5\uc7a5\uc740 \uc2b9\uc778\ubcf8\uc73c\ub85c\ub9cc \ub9cc\ub4e0\ub2e4)"
    },
    "revision": {
      "type": "number",
      "description": "\uc2b9\uc778\ubcf8 \ud310 \ubc88\ud638 (\ub300\uccb4\ud560 \ub54c\ub9c8\ub2e4 1\uc529 \uc62c\ub77c\uac10)"
    },
    "approved_at": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "supersedes_id": {
      "type": "string",
      "description": "\uc774 \uc2b9\uc778\ubcf8\uc774 \ub300\uccb4\ud55c \uc774\uc804 \uc2b9\uc778\ubcf8 ID"
    },
    "superseded_by_id": {
      "type": "string",
      "description": "\uc774 \ud30c\uc77c\uc744 \ub300\uccb4\ud55c \uc0c8 \uc2b9\uc778\ubcf8 ID. \uc788\uc73c\uba74 '\uc0ac\uc6a9 \uc548 \ud568'"
    },
    "superseded_at": {
      "type": "string"
    },
    "sent_to_factory_at": {
      "type": "string",
      "description": "\uacf5\uc7a5\uc5d0 \ubcf4\ub0b8 \uc2dc\uac01 (\uae30\ub85d)"
    },
    "sent_to_factory_by_name": {
      "type": "string"
    },
    "client_review_id": {
      "type": "string",
      "description": "\uc774 \ud30c\uc77c\uc758 \ucd5c\uadfc \uace0\uac1d \ud655\uc778 \uc694\uccad(FileReview) id"
    },
    "client_review_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REVISION_REQUESTED",
        "CANCELED"
      ],
      "description": "\uace0\uac1d \ud655\uc778 \uc0c1\ud0dc (FileReview \uc640 \uac19\uc740 \uac12, \ubaa9\ub85d \ud45c\uc2dc\uc6a9)"
    },
    "client_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uace0\uac1d\uc774 \uc774 \ud310\uc744 \uc2b9\uc778\ud55c \uc2dc\uac01"
    },
    "client_approved_by_name": {
      "type": "string",
      "description": "\uc774 \ud310\uc744 \uc2b9\uc778\ud55c \uace0\uac1d"
    },
    "factory_request_id": {
      "type": "string",
      "description": "\uacf5\uc7a5 \uc5c5\ub85c\ub4dc \ub9c1\ud06c\ub85c \ubc1b\uc740 \ud30c\uc77c\uc774\uba74 \uadf8 \uc694\uccad"
    }
  },
  "required": [
    "card_id",
    "file_name",
    "file_url"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}