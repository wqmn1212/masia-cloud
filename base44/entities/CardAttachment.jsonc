{
  "name": "CardAttachment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "uploader_name": {
      "type": "string"
    },
    "uploader_role": {
      "type": "string",
      "enum": [
        "HQ",
        "AGENT"
      ]
    },
    "ai_parsed_text": {
      "type": "string"
    },
    "ai_parse_status": {
      "type": "string",
      "enum": [
        "NONE",
        "PENDING",
        "DONE",
        "FAILED"
      ]
    },
    "document_type": {
      "type": "string",
      "enum": [
        "GENERAL",
        "INVOICE_CI",
        "INVOICE_PI",
        "PACKING_LIST",
        "QUOTATION",
        "REMITTANCE_ACCOUNT"
      ],
      "default": "GENERAL"
    },
    "source_bank_document_id": {
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "file_name",
    "file_url"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}