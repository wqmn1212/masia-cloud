{
  "name": "CardAttachment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string",
      "description": "\uc885\uc18d\ub41c TaskCard ID"
    },
    "folder_id": {
      "type": "string",
      "description": "\uc18d\ud55c \ud3f4\ub354 ID (\uc5c6\uc73c\uba74 \ub8e8\ud2b8)"
    },
    "file_name": {
      "type": "string",
      "description": "\ud30c\uc77c\uba85"
    },
    "file_type": {
      "type": "string",
      "description": "\ud655\uc7a5\uc790 (pdf, xlsx, mp4, jpg \ub4f1)"
    },
    "file_url": {
      "type": "string",
      "description": "\uc5c5\ub85c\ub4dc\ub41c \ud30c\uc77c URL"
    },
    "uploader_name": {
      "type": "string",
      "description": "\uc5c5\ub85c\ub354 \uc774\ub984"
    },
    "uploader_role": {
      "type": "string",
      "enum": [
        "HQ",
        "AGENT"
      ],
      "description": "\uc5c5\ub85c\ub354 \uc5ed\ud560"
    },
    "ai_parsed_text": {
      "type": "string",
      "description": "AI \ud30c\uc2f1 \uacb0\uacfc \ud14d\uc2a4\ud2b8"
    },
    "ai_parse_status": {
      "type": "string",
      "enum": [
        "NONE",
        "PENDING",
        "DONE",
        "FAILED"
      ]
    }
  },
  "required": [
    "card_id",
    "file_name",
    "file_url"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}