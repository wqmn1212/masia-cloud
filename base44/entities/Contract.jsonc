{
  "name": "Contract",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "quotation_id": {
      "type": "string",
      "description": "\uae30\ubc18 \uacac\uc801 ID"
    },
    "contract_title": {
      "type": "string",
      "description": "\uacc4\uc57d\uc11c \uc81c\ubaa9"
    },
    "client_name": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac\uba85"
    },
    "factory_name": {
      "type": "string",
      "description": "\uacf5\uc7a5\uba85 (\ub0b4\ubd80\uc6a9)"
    },
    "contract_date": {
      "type": "string",
      "format": "date",
      "description": "\uacc4\uc57d \uccb4\uacb0\uc77c"
    },
    "amount_usd": {
      "type": "number",
      "description": "\uacc4\uc57d \uae08\uc561 (USD)"
    },
    "body": {
      "type": "string",
      "description": "\uacc4\uc57d\uc11c \ubcf8\ubb38 (\ud2b9\uc57d \uc870\ud56d \ud3ec\ud568)"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "SENT",
        "SIGNED",
        "CANCELLED"
      ],
      "default": "DRAFT",
      "description": "\uacc4\uc57d \uc0c1\ud0dc"
    },
    "card_id": {
      "type": "string",
      "description": "\uce74\ub4dc TaskCard ID"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac Company ID (\uc11c\uba85\uc790\ub97c \uace0\ub97c \ub54c \uc500)"
    },
    "contract_type": {
      "type": "string",
      "description": "SUPPLY \uacf5\uae09 \u00b7 SERVICE \uc6d4 \uad6c\ub3c5 \u00b7 AMENDMENT \ubcc0\uacbd \u00b7 TRIPARTITE 3\uc790",
      "enum": [
        "SUPPLY",
        "SERVICE",
        "AMENDMENT",
        "TRIPARTITE"
      ]
    },
    "service_agreement_id": {
      "type": "string",
      "description": "\uc6d4 \uad6c\ub3c5 \uacc4\uc57d\uc11c\uc77c \ub54c ServiceAgreement ID"
    },
    "amends_contract_id": {
      "type": "string",
      "description": "\ubcc0\uacbd \uacc4\uc57d\uc11c\uac00 \ubc14\uafb8\ub294 \uc6d0\ub798 \uacc4\uc57d"
    },
    "current_request_id": {
      "type": "string",
      "description": "\uc9c4\ud589 \uc911\uc774\uac70\ub098 \ub9c8\uc9c0\ub9c9 \uc11c\uba85 \uc694\uccad ID"
    },
    "signed_at": {
      "type": "string",
      "description": "\uccb4\uacb0 \uc2dc\uac01 (\uc11c\uba85 \uc644\ub8cc \ub54c \uc11c\ubc84\uac00 \uae30\ub85d)"
    },
    "signed_file_uri": {
      "type": "string",
      "description": "\uc644\ub8cc\ubcf8 PDF (\ube44\uacf5\uac1c)"
    },
    "signed_offline": {
      "type": "boolean",
      "description": "\uc885\uc774 \uacc4\uc57d\uc73c\ub85c \uccb4\uacb0 (\uc2a4\uce94\ubcf8 \ubcf4\uad00)"
    },
    "offline_file_uri": {
      "type": "string",
      "description": "\uc885\uc774 \uacc4\uc57d \uc2a4\uce94\ubcf8 (\ube44\uacf5\uac1c)"
    }
  },
  "required": [
    "contract_title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}
