{
  "name": "DecisionLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "quotation_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "topic_cn": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "MATERIAL",
        "PROCESS",
        "SUPPLIER",
        "PRICING",
        "CONTRACT",
        "REGULATORY",
        "DESIGN",
        "OTHER"
      ],
      "default": "OTHER"
    },
    "decision": {
      "type": "string"
    },
    "decision_cn": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "rationale_cn": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option": {
            "type": "string"
          },
          "reject_reason": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "CONFIRMED",
        "REVERSED",
        "SUPERSEDED"
      ],
      "default": "CONFIRMED"
    },
    "supersedes_id": {
      "type": "string"
    },
    "reverse_reason": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date"
    },
    "source_ref": {
      "type": "string"
    },
    "impact_note": {
      "type": "string"
    },
    "cn_manual": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tenant_id",
    "topic",
    "decision"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}