{
  "name": "DecisionLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c TaskCard"
    },
    "quotation_id": {
      "type": "string",
      "description": "\uad00\ub828 \uacac\uc801\uc11c (\uc120\ud0dd)"
    },
    "topic": {
      "type": "string",
      "description": "\uacb0\uc815 \uc8fc\uc81c. \uc608: N30 \uc804\uadf9 \ud45c\uba74 \ub9c8\uac10"
    },
    "category": {
      "type": "string",
      "enum": [
        "MATERIAL",
        "PROCESS",
        "SUPPLIER",
        "PRICING",
        "CONTRACT",
        "REGULATORY",
        "DESIGN",
        "OTHER"
      ],
      "default": "OTHER",
      "description": "\uacb0\uc815 \ubd84\ub958"
    },
    "decision": {
      "type": "string",
      "description": "\ud655\uc815 \ub0b4\uc6a9"
    },
    "rationale": {
      "type": "string",
      "description": "\uadf8\ub807\uac8c \uc815\ud55c \uadfc\uac70"
    },
    "alternatives": {
      "type": "array",
      "description": "\uac80\ud1a0\ud588\uc73c\ub098 \uae30\uac01\ud55c \ub300\uc548. \uc774 \ubc30\uc5f4\uc774 \uc774 \uc5d4\ud2f0\ud2f0\uc758 \ud575\uc2ec\uc774\ub2e4",
      "items": {
        "type": "object",
        "properties": {
          "option": {
            "type": "string",
            "description": "\ub300\uc548 \ub0b4\uc6a9"
          },
          "reject_reason": {
            "type": "string",
            "description": "\uae30\uac01 \uc0ac\uc720"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "CONFIRMED",
        "REVERSED",
        "SUPERSEDED"
      ],
      "default": "CONFIRMED",
      "description": "\uacb0\uc815 \uc0c1\ud0dc"
    },
    "supersedes_id": {
      "type": "string",
      "description": "\uc774 \uacb0\uc815\uc774 \ub4a4\uc9d1\uc740 \uc774\uc804 \uacb0\uc815 ID"
    },
    "reverse_reason": {
      "type": "string",
      "description": "\ubc88\ubcf5 \uc0ac\uc720"
    },
    "decided_by": {
      "type": "string",
      "description": "\uacb0\uc815\uc790"
    },
    "decided_at": {
      "type": "string",
      "format": "date",
      "description": "\uacb0\uc815\uc77c"
    },
    "source_ref": {
      "type": "string",
      "description": "\uadfc\uac70 \ubb38\uc11c\u00b7\ud68c\uc758\ub85d\u00b7\ub300\ud654 \ucc38\uc870"
    },
    "impact_note": {
      "type": "string",
      "description": "\uc6d0\uac00\u00b7\ub0a9\uae30\u00b7\uc778\uc99d\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5"
    }
  },
  "required": [
    "tenant_id",
    "topic",
    "decision"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}