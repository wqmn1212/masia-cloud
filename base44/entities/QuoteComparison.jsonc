{
  "name": "QuoteComparison",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string",
      "description": "\ub300\uc0c1 \ud0dc\uc2a4\ud06c \uce74\ub4dc ID"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac Company ID (\uce74\ub4dc\uc758 client_id)"
    },
    "version": {
      "type": "number",
      "description": "\uacf5\uac1c\ud560 \ub54c\ub9c8\ub2e4 1\uc529 \uc62c\ub77c\uac10",
      "default": 1
    },
    "title": {
      "type": "string",
      "description": "\ube44\uad50\ud45c \uc81c\ubaa9 (\uae30\ubcf8\uac12: \uce74\ub4dc \uc81c\ubaa9)"
    },
    "base_currency": {
      "type": "string",
      "description": "\ube44\uad50 \uae30\uc900 \ud1b5\ud654",
      "enum": [
        "KRW",
        "USD",
        "CNY"
      ],
      "default": "KRW"
    },
    "duty_rate": {
      "type": "number",
      "description": "\ub3c4\ucc29 \uc6d0\uac00 \uacc4\uc0b0\uc5d0 \uc4f0\ub294 \uad00\uc138\uc728 % (\uae30\ubcf8 8)",
      "default": 8
    },
    "fx": {
      "type": "object",
      "description": "\uacc4\uc0b0\uc5d0 \uc4f4 \ud658\uc728 { usd_krw, usd_cny, date }",
      "properties": {
        "usd_krw": {
          "type": "number"
        },
        "usd_cny": {
          "type": "number"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "options": {
      "type": "array",
      "description": "\uc548 \ubaa9\ub85d. \uae08\uc561\uc740 \uc800\uc7a5\ud558\uc9c0 \uc54a\uace0 \uacac\uc801\uc5d0\uc11c \ub2e4\uc2dc \uacc4\uc0b0\ud55c\ub2e4",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "A\u00b7B\u00b7C\u00b7D\u00b7E"
          },
          "label": {
            "type": "string",
            "description": "\uc548 \uc774\ub984 (\uc608: A\uc548, \uc591\uba74\uc548)"
          },
          "quotation_id": {
            "type": "string"
          },
          "show_factory_name": {
            "type": "boolean",
            "description": "\uace0\uac1d\uc5d0\uac8c \uacf5\uc7a5\uba85 \ubcf4\uc5ec \uc8fc\uae30 (\uae30\ubcf8 \uac00\ub9bc)"
          },
          "cargo": {
            "type": "object",
            "description": "\ud3ec\uc7a5 \ubd80\ud53c\u00b7\ubb34\uac8c { cbm, kg }",
            "properties": {
              "cbm": {
                "type": "number"
              },
              "kg": {
                "type": "number"
              }
            }
          },
          "conditions": {
            "type": "object",
            "description": "\uc9c1\uc6d0\uc774 \ud655\uc778\u00b7\uc218\uc815\ud55c \uc870\uac74 { lead, payment, warranty, power, packing, valid, moq, tax }"
          },
          "extra": {
            "type": "object",
            "description": "\uc9c1\uc6d0\uc774 \ucd94\uac00\ud55c \uc870\uac74 \ud589\uc758 \uac12 { \ud589 key: \uac12 }"
          },
          "choice": {
            "type": "object",
            "description": "\uc120\ud0dd \ud488\ubaa9 \ud589\ubcc4\ub85c \ud569\uacc4\uc5d0 \ub123\uc744 \uc904 { \ud589 key: \uc904 \ubc88\ud638 }"
          },
          "logistics_scope": {
            "type": "string",
            "description": "\uacac\uc801 \uc548 \ubc30\uc1a1\ube44\uac00 \uc5b4\ub514\uae4c\uc9c0\uc778\uc9c0 (PORT: \ud56d\uad6c\uae4c\uc9c0, DOOR: \ubb38 \uc55e\uae4c\uc9c0)"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "description": "\ube44\uad50 \ud589: \uc548\ubcc4 \uce78\uc5d0 \uacac\uc801 \ud488\ubaa9 \uc904 \ubc88\ud638\uc640 \uc0c1\ud0dc",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ITEM",
              "OPTIONAL",
              "ONE_TIME",
              "LOGISTICS"
            ]
          },
          "cells": {
            "type": "object",
            "description": "{ \uc548 key: { lines: [\uc904 \ubc88\ud638], state: PRICED|INCLUDED|NOT_INCLUDED|UNKNOWN, auto } }"
          }
        }
      }
    },
    "extra_conditions": {
      "type": "array",
      "description": "\uc9c1\uc6d0\uc774 \ucd94\uac00\ud55c \uc870\uac74 \ud589",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "description": "\ucd94\ucc9c \uc758\uacac \ud55c \uc904 (\uace0\uac1d\uc5d0\uac8c \ubcf4\uc784)"
    },
    "staff_note": {
      "type": "string",
      "description": "\ub0b4\ubd80 \uba54\ubaa8 (\uace0\uac1d\uc5d0\uac8c \uc548 \ubcf4\uc784)"
    },
    "status": {
      "type": "string",
      "description": "\uc0c1\ud0dc",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "CHOSEN",
        "CONFIRMED",
        "CLOSED"
      ],
      "default": "DRAFT"
    },
    "source_hashes": {
      "type": "object",
      "description": "\uacf5\uac1c\ud560 \ub54c \uc548\ubcc4 \uacac\uc801 \ud574\uc2dc { \uc548 key: \ud574\uc2dc }. \uc9c0\uae08 \uacac\uc801\uacfc \ub2e4\ub974\uba74 '\uacac\uc801\uc774 \ubc14\ub00c\uc5c8\uc2b5\ub2c8\ub2e4'"
    },
    "published_at": {
      "type": "string",
      "description": "\ub9c8\uc9c0\ub9c9 \uacf5\uac1c \uc2dc\uc810"
    },
    "published_by_name": {
      "type": "string",
      "description": "\ub9c8\uc9c0\ub9c9\uc73c\ub85c \uacf5\uac1c\ud55c \uc9c1\uc6d0"
    },
    "client_snapshot": {
      "type": "object",
      "description": "\uace0\uac1d\uc5d0\uac8c \ubcf4\uc778 \ud45c \uadf8\ub300\ub85c (\uc6d0\uac00\u00b7\ub9c8\uc9c4\u00b7\uacf5\uc7a5\uba85\u00b7\uacac\uc801 ID \uc5c6\uc74c)"
    },
    "client_choice": {
      "type": "object",
      "description": "\uace0\uac1d\uc774 \uace0\ub978 \uc548 { option_key, note, by_name, at }"
    },
    "choice_history": {
      "type": "array",
      "description": "\uace0\uac1d\uc774 \uc548\uc744 \uace0\ub974\uac70\ub098 \ubc14\uafbc \uae30\ub85d",
      "items": {
        "type": "object",
        "properties": {
          "option_key": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "confirmed_option_key": {
      "type": "string",
      "description": "\uc9c1\uc6d0\uc774 \ud655\uc815\ud55c \uc548"
    },
    "confirmed_at": {
      "type": "string",
      "description": "\ud655\uc815 \uc2dc\uc810"
    },
    "confirmed_by_name": {
      "type": "string",
      "description": "\ud655\uc815\ud55c \uc9c1\uc6d0"
    },
    "created_by_name": {
      "type": "string",
      "description": "\ub9cc\ub4e0 \uc0ac\ub78c"
    }
  },
  "required": [
    "card_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}
