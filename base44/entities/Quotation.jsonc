{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c TaskCard ID"
    },
    "factory_id": {
      "type": "string",
      "description": "\uacf5\uc7a5 ID"
    },
    "factory_name": {
      "type": "string",
      "description": "\uacf5\uc7a5\uba85 (\ub0b4\ubd80\uc6a9 \u2014 \uace0\uac1d PDF \ubbf8\ub178\ucd9c)"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac ID"
    },
    "client_name": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac\uba85"
    },
    "machine_template_id": {
      "type": "string",
      "description": "\uc7a5\ube44 \ud15c\ud50c\ub9bf ID"
    },
    "machine_category": {
      "type": "string",
      "enum": [
        "DRIP_BAG",
        "SLEEVE",
        "DESKTOP_LABELER",
        "TUBE_SEALER"
      ],
      "description": "\uc7a5\ube44 \uce74\ud14c\uace0\ub9ac"
    },
    "incoterms": {
      "type": "string",
      "enum": [
        "EXW",
        "FCA",
        "CPT",
        "CIP",
        "DAP",
        "DPU",
        "DDP",
        "FAS",
        "FOB",
        "CFR",
        "CIF",
        "FOB_SHANGHAI",
        "FOB_GUANGZHOU"
      ],
      "description": "\uc778\ucf54\ud140\uc988 (Incoterms 2020 \u2014 11\uac00\uc9c0 \uc870\uac74 + \ub808\uac70\uc2dc \ud56d\uad6c \uc9c0\uc815 FOB)"
    },
    "quote_title": {
      "type": "string",
      "description": "\uacac\uc801\uc11c \uc81c\ubaa9"
    },
    "product_name": {
      "type": "string",
      "description": "\uc81c\ud488\uba85"
    },
    "model_name": {
      "type": "string",
      "description": "\ubaa8\ub378\uba85"
    },
    "product_image_url": {
      "type": "string",
      "description": "\uc81c\ud488 \uc0ac\uc9c4 URL (PDF \ud45c\uc2dc)"
    },
    "remarks": {
      "type": "string",
      "description": "\ube44\uace0 (PDF \ud45c\uc2dc)"
    },
    "advance_payment_percent": {
      "type": "number",
      "description": "\uc120\uae08 %"
    },
    "balance_payment_percent": {
      "type": "number",
      "description": "\uc794\uae08 %"
    },
    "shipping_days": {
      "type": "number",
      "description": "\ucd9c\ud558\uc77c (\ubc1c\uc8fc \uc2dc\uc810\uc73c\ub85c\ubd80\ud130 N\uc77c)"
    },
    "final_currency": {
      "type": "string",
      "enum": [
        "USD",
        "CNY",
        "KRW"
      ],
      "default": "USD",
      "description": "\uace0\uac1d PDF \ucd5c\uc885 \uba54\uc778 \ud45c\uc2dc \ud1b5\ud654"
    },
    "quote_options": {
      "type": "array",
      "description": "\uc81c\ud488 \uc635\uc158/\uc138\ubd80 \ud56d\ubaa9 \ub9ac\uc2a4\ud2b8 (\ud1b5\ud654\ubcc4 \uc785\ub825, USD \ud658\uc0b0 \uc800\uc7a5)",
      "items": {
        "type": "object",
        "properties": {
          "option_name": {
            "type": "string",
            "description": "\uc635\uc158/\ud56d\ubaa9\uba85"
          },
          "specification": {
            "type": "string",
            "description": "\uc138\ubd80 \uc0ac\uc591"
          },
          "quantity": {
            "type": "number",
            "description": "\uc218\ub7c9"
          },
          "unit_price": {
            "type": "number",
            "description": "\ub2e8\uac00 (\uc785\ub825 \ud1b5\ud654 \uae30\uc900)"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY",
              "KRW"
            ],
            "description": "\ub2e8\uac00 \uc785\ub825 \ud1b5\ud654"
          },
          "margin_percent": {
            "type": "number",
            "description": "\ud56d\ubaa9\ubcc4 \ub9c8\uc9c4\uc728 (%)"
          },
          "unit_price_usd": {
            "type": "number",
            "description": "(\ub808\uac70\uc2dc) \ub2e8\uac00 USD"
          },
          "total_usd": {
            "type": "number",
            "description": "\uae08\uc561 (USD \ud658\uc0b0, \ub9c8\uc9c4 \ubbf8\ud3ec\ud568 \uc6d0\uac00)"
          }
        }
      },
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "options_total_usd": {
      "type": "number",
      "description": "\uc635\uc158 \ud569\uc0b0 \ucd1d\uc561 (USD) = \uacf5\uc7a5 \uc6d0\uac00",
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "final_price_usd": {
      "type": "number",
      "description": "\ud56d\ubaa9\ubcc4 \ub9c8\uc9c4 + \uc218\uc218\ub8cc \ud3ec\ud568 \ucd5c\uc885 \uc81c\uc548\uac00 (USD)",
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "raw_file_url": {
      "type": "string",
      "description": "\uc6d0\ubcf8 \ud30c\uc77c URL"
    },
    "ai_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PROCESSING",
        "SUCCESS",
        "FAILED"
      ],
      "description": "AI \ud30c\uc2f1 \uc0c1\ud0dc"
    },
    "line_items": {
      "type": "array",
      "description": "\uacac\uc801 \ud56d\ubaa9 \ub9ac\uc2a4\ud2b8",
      "items": {
        "type": "object",
        "properties": {
          "item_name_cn": {
            "type": "string"
          },
          "item_name_ko": {
            "type": "string"
          },
          "specification": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price_cny": {
            "type": "number"
          },
          "total_cny": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      }
    },
    "factory_total_cost": {
      "type": "number",
      "description": "\uacf5\uc7a5 \uc6d0\uac00 (CNY \ud658\uc0b0 \uc800\uc7a5)"
    },
    "factory_cost_currency": {
      "type": "string",
      "enum": [
        "CNY",
        "USD",
        "KRW"
      ],
      "description": "\uacf5\uc7a5 \uc6d0\uac00 \uc785\ub825 \ud1b5\ud654"
    },
    "logistics_cost": {
      "type": "number",
      "description": "\ubb3c\ub958\ube44 (CNY \ud658\uc0b0 \uc800\uc7a5)"
    },
    "logistics_cost_currency": {
      "type": "string",
      "enum": [
        "CNY",
        "USD",
        "KRW"
      ],
      "description": "\ubb3c\ub958\ube44 \uc785\ub825 \ud1b5\ud654"
    },
    "masir_fee_type": {
      "type": "string",
      "enum": [
        "PERCENT",
        "FIXED"
      ],
      "description": "\ub9c8\uc2dc\uc544 \uc218\uc218\ub8cc \uc720\ud615",
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "masir_fee_value": {
      "type": "number",
      "description": "\ub9c8\uc2dc\uc544 \uc218\uc218\ub8cc \uac12 (% \ub610\ub294 CNY \uace0\uc815)",
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "masir_fee_amount_cny": {
      "type": "number",
      "description": "\ub9c8\uc2dc\uc544 \uc218\uc218\ub8cc \uacc4\uc0b0 \uae08\uc561 (CNY)",
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "final_client_price": {
      "type": "number",
      "description": "\uace0\uac1d \uc81c\uc548\uac00 (CNY)",
      "rls": {
        "read": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "data.account_tier": "master" } },
            { "user_condition": { "data.account_tier": "service" } }
          ]
        }
      }
    },
    "exchange_rate_date": {
      "type": "string",
      "format": "date",
      "description": "\ud658\uc728 \uae30\uc900 \ub0a0\uc9dc"
    },
    "exchange_rate_usd": {
      "type": "number",
      "description": "\ub2f9\uc77c \ud658\uc728: 1 USD = ? KRW"
    },
    "exchange_rate_krw": {
      "type": "number",
      "description": "\ub2f9\uc77c \ud658\uc728: 1 CNY = ? KRW"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "SENT",
        "ACCEPTED",
        "REJECTED"
      ],
      "description": "\uacac\uc801 \uc0c1\ud0dc"
    }
  },
  "required": [
    "factory_name"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "data.account_tier": "master" } },
        { "user_condition": { "data.account_tier": "service" } },
        { "user_condition": { "data.account_tier": "sub" } }
      ]
    },
    "read": {
      "$or": [
        { "user_condition": { "data.account_tier": "master" } },
        { "user_condition": { "data.account_tier": "service" } },
        { "user_condition": { "data.account_tier": "sub" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "data.account_tier": "master" } },
        { "user_condition": { "data.account_tier": "service" } },
        { "user_condition": { "data.account_tier": "sub" } }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "data.account_tier": "master" } },
        { "user_condition": { "data.account_tier": "service" } }
      ]
    }
  }
}