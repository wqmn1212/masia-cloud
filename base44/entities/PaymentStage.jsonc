{
  "name": "PaymentStage",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string"
    },
    "stage_type": {
      "type": "string",
      "enum": [
        "DOWN_PAYMENT",
        "INTERIM_PAYMENT",
        "BALANCE_PAYMENT"
      ]
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "default": "PENDING"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "\uc2e4\uc81c \uc785\uae08\uc77c"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "\uc774 \ub2e8\uacc4 \uae08\uc561 (\uc120\ud0dd)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "KRW",
        "USD",
        "CNY"
      ],
      "description": "\uae08\uc561 \ud1b5\ud654"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\uacb0\uc81c \uae30\ud55c (\uacb0\uc81c \uc694\uccad\uc5d0 \uc801\uc740 \ub0a0)"
    },
    "payee": {
      "type": "string",
      "enum": [
        "AEGIS",
        "FACTORY"
      ],
      "description": "\ubc1b\ub294 \uacf3: \uc774\uc9c0\uc2a4 \uacc4\uc88c \ub610\ub294 \ud655\uc778\ub41c \uacf5\uc7a5 \uacc4\uc88c"
    },
    "payee_account_id": {
      "type": "string",
      "description": "\uc774\uc9c0\uc2a4 \ubc1b\ub294 \uacc4\uc88c(PayeeAccount) ID. \uace0\uac1d \ud654\uba74\uc740 \uc774 ID\ub85c \ub9c8\uc2a4\ud130\uac00 \ub4f1\ub85d\ud55c \uacc4\uc88c\ub97c \uadf8\ub54c\uadf8\ub54c \ubd88\ub7ec\uc628\ub2e4"
    },
    "request_note": {
      "type": "string",
      "description": "\uacb0\uc81c \uc694\uccad \uba54\ubaa8 (\uace0\uac1d\uc5d0\uac8c \ubcf4\uc784)"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uacb0\uc81c \uc694\uccad\uc744 \ubcf4\ub0b8 \uc2dc\uac01. \ube44\uc5b4 \uc788\uc73c\uba74 \uace0\uac1d\uc5d0\uac8c \uacb0\uc81c \uc694\uccad\uc774 \uc5c6\ub2e4"
    },
    "requested_by_name": {
      "type": "string"
    },
    "client_reported_paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uace0\uac1d\uc774 '\uc1a1\uae08\ud588\uc5b4\uc694'\ub97c \ub204\ub978 \uc2dc\uac01. \uc785\uae08 \ud655\uc778\uc774 \uc544\ub2c8\ub77c \uc9c1\uc6d0 \ud655\uc778 \uc694\uccad"
    },
    "client_reported_paid_date": {
      "type": "string",
      "format": "date",
      "description": "\uace0\uac1d\uc774 \uc801\uc740 \uc1a1\uae08\uc77c"
    },
    "client_reported_by_name": {
      "type": "string"
    },
    "client_report_note": {
      "type": "string",
      "description": "\uace0\uac1d \uc1a1\uae08 \uba54\ubaa8"
    },
    "reminder_sent_for": {
      "type": "string",
      "description": "\uacb0\uc81c \uae30\ud55c \uc54c\ub9bc\uc744 \ubcf4\ub0b8 \uae30\uc900 (\uae30\ud55c:\ub2e8\uacc4). \uac19\uc740 \uae30\ud55c\u00b7\ub2e8\uacc4\ub85c \ub2e4\uc2dc \ubcf4\ub0b4\uc9c0 \uc54a\ub294\ub2e4"
    },
    "overdue_notified_for": {
      "type": "string",
      "description": "\uae30\ud55c \uc9c0\ub0a8 \uc54c\ub9bc\uc744 \uc9c1\uc6d0\uc5d0\uac8c \ubcf4\ub0b8 \uae30\ud55c"
    }
  },
  "required": [
    "card_id",
    "stage_type",
    "percentage",
    "approval_status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}