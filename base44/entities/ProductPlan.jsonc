{
  "name": "ProductPlan",
  "type": "object",
  "description": "\uace0\uac1d \uc0c1\ud488\ubcc4 \uc7ac\uace0\u00b7\uc6d4 \uc0ac\uc6a9\ub7c9 (\uc7ac\uc8fc\ubb38 \uc2dc\uc810 \uc54c\ub9bc\uc6a9). \uace0\uac1d\uc774 \uc0c1\ud488 \uc6d0\uac00 \ud654\uba74\uc5d0\uc11c \uc801\uace0, \uc4f0\uae30\ub294 \uc11c\ubc84 \ud568\uc218(manageProductPlan)\ub9cc",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc0c1\ud488 \uce74\ub4dc \uc18c\uc720 \ud300(\ubcf8\uc0ac) \u2014 \uc9c1\uc6d0 \uc77d\uae30 \ubc94\uc704"
    },
    "company_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac"
    },
    "product_key": {
      "type": "string",
      "description": "\uc0c1\ud488 \ubb36\uc74c (\uc7ac\uc8fc\ubb38 \uccb4\uc778\uc758 \ucc98\uc74c \uce74\ub4dc id, LandedCostRecord.product_key)"
    },
    "product_name": {
      "type": "string"
    },
    "unit_label": {
      "type": "string"
    },
    "stock_qty": {
      "type": "number",
      "description": "\ud604\uc7ac \uc7ac\uace0"
    },
    "monthly_usage": {
      "type": "number",
      "description": "\uc6d4 \uc0ac\uc6a9\ub7c9(\ud310\ub9e4\ub7c9)"
    },
    "stock_as_of": {
      "type": "string",
      "format": "date",
      "description": "\uc7ac\uace0\ub97c \uc13c \ub0a0"
    },
    "alerted_for": {
      "type": "string",
      "description": "\uc8fc\ubb38 \uc2dc\uc810 \uc54c\ub9bc\uc744 \ubcf4\ub0b8 \uc8fc\ubb38 \uad8c\uc7a5\uc77c (\uac19\uc740 \ub0a0\uc9dc\ub85c \ub450 \ubc88 \ubcf4\ub0b4\uc9c0 \uc54a\uc74c)"
    },
    "alerted_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by_name": {
      "type": "string"
    },
    "incoming_qty": {
      "type": "number",
      "description": "\uc785\uace0 \uc608\uc815 \uc218\ub7c9 (\uc774\ubbf8 \ubc1c\uc8fc\ud574 \uc624\ub294 \uc911\uc778 \uac83)"
    },
    "safety_weeks": {
      "type": "number",
      "description": "\uc548\uc804\uc7ac\uace0 (\uc8fc \ub2e8\uc704 \ud310\ub9e4\ub7c9)"
    },
    "cycle_months": {
      "type": "number",
      "description": "\ubc1c\uc8fc \uc8fc\uae30 (\uac1c\uc6d4) \u2014 \uad8c\uc7a5 \ubc1c\uc8fc\ub7c9 \uacc4\uc0b0"
    },
    "moq": {
      "type": "number",
      "description": "\ucd5c\uc18c \uc8fc\ubb38 \uc218\ub7c9"
    },
    "order_by": {
      "type": "string",
      "format": "date",
      "description": "\uacc4\uc0b0\ud574 \ub454 \uc8fc\ubb38 \uad8c\uc7a5\uc77c (\uc77c\uc77c \uc810\uac80\u00b7\uc800\uc7a5 \ub54c \uac31\uc2e0, \uc9c1\uc6d0 \ubaa9\ub85d\u00b7\uace0\uac1d \ud560 \uc77c\uc6a9)"
    },
    "runout": {
      "type": "string",
      "format": "date",
      "description": "\uacc4\uc0b0\ud574 \ub454 \uc608\uc0c1 \uc18c\uc9c4\uc77c"
    },
    "lead_days": {
      "type": "number",
      "description": "\uacc4\uc0b0\uc5d0 \uc4f4 \ubc1c\uc8fc\u2192\ub3c4\ucc29 \uc77c\uc218 (\uc9c0\ub09c \uc8fc\ubb38 \ud3c9\uade0)"
    },
    "recommended_qty": {
      "type": "number",
      "description": "\uacc4\uc0b0\ud574 \ub454 \uad8c\uc7a5 \ubc1c\uc8fc\ub7c9"
    },
    "computed_on": {
      "type": "string",
      "format": "date",
      "description": "\uc704 \uac12\uc744 \uacc4\uc0b0\ud55c \ub0a0"
    }
  },
  "required": [
    "tenant_id",
    "company_id",
    "product_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}
