{
  "name": "ProjectAuditLog",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PAYMENT_APPROVED",
        "QC_RECORDED",
        "PRODUCTION_STARTED",
        "SHIPMENT_COMPLETED",
        "SHIPMENT_OVERRIDDEN"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "event_type",
    "details"
  ],
  "rls": {
    "create": { "$or": [
      { "user_condition": { "data.account_tier": "master" } },
      { "user_condition": { "data.account_tier": "service" } },
      { "user_condition": { "data.account_tier": "sub" } }
    ] },
    "read": { "$or": [
      { "user_condition": { "data.account_tier": "master" } },
      { "user_condition": { "data.account_tier": "service" } },
      { "user_condition": { "data.account_tier": "sub" } }
    ] },
    "update": { "user_condition": { "data.account_tier": "master" } },
    "delete": { "user_condition": { "data.account_tier": "master" } }
  }
}