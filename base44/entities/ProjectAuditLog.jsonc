{
  "name": "ProjectAuditLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PAYMENT_APPROVED",
        "QC_RECORDED",
        "PRODUCTION_STARTED",
        "SHIPMENT_COMPLETED",
        "SHIPMENT_OVERRIDDEN",
        "CONTRACT_CREATED",
        "CONTRACT_STATUS_CHANGED",
        "QC_PUBLISHED",
        "QC_CLIENT_DECISION",
        "SPEC_SENT",
        "SPEC_CLIENT_DECISION",
        "DEST_COST_CLIENT_DECISION",
        "CLAIM_SUBMITTED",
        "CLAIM_UPDATED",
        "COMPARISON_CLIENT_CHOICE",
        "LANDED_COST_CONFIRMED",
        "PAYMENT_REQUESTED",
        "PAYMENT_REQUEST_CANCELED",
        "PAYMENT_REPORTED",
        "CLIENT_APPROVAL_REQUESTED",
        "CLIENT_APPROVAL_APPROVED",
        "CLIENT_APPROVAL_REJECTED",
        "CLIENT_APPROVAL_CANCELED",
        "QUOTE_CLIENT_ACCEPTED",
        "FILE_REVIEW_REQUESTED",
        "FILE_REVIEW_CANCELED",
        "FILE_REVIEW_DECISION",
        "QUOTE_REVIEW_REQUESTED",
        "QUOTE_REVIEW_REJECTED",
        "QUOTE_APPROVED_SENT",
        "QUOTE_UNPUBLISHED"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "event_type",
    "details"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}
