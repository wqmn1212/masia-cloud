{
  "name": "MeetingLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "ONLINE",
        "OFFLINE",
        "CALL",
        "WECHAT"
      ],
      "default": "ONLINE"
    },
    "title": {
      "type": "string"
    },
    "attendees": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "decisions": {
      "type": "string"
    },
    "next_steps": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "transcript": {
      "type": "string",
      "description": "\uc804\uc0ac\ubb38 \ubbf8\ub9ac\ubcf4\uae30, \uae34 \uc804\ubb38\uc740 transcript_uri\uc5d0 \ubcf4\uad00"
    },
    "transcript_uri": {
      "type": "string"
    },
    "recording_uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audio_status": {
      "type": "string",
      "enum": [
        "NONE",
        "RECORDING",
        "UPLOADING",
        "TRANSCRIBING",
        "DONE",
        "FAILED"
      ],
      "default": "NONE"
    },
    "audio_session": {
      "type": "string"
    },
    "audio_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "transcript_uri": {
            "type": "string"
          }
        }
      }
    },
    "analysis_uri": {
      "type": "string"
    },
    "analysis_applied_uri": {
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "meeting_date",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}