{
  "name": "TaskItem",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "card_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c TaskCard ID"
    },
    "title": {
      "type": "string",
      "description": "\uc138\ubd80 \uc5c5\ubb34 \uc81c\ubaa9"
    },
    "title_cn": {
      "type": "string",
      "description": "\uc81c\ubaa9 \uc911\uad6d\uc5b4 \ubc88\uc5ed (\uc790\ub3d9)"
    },
    "description": {
      "type": "string",
      "description": "\uc0c1\uc138 \ub0b4\uc6a9"
    },
    "description_cn": {
      "type": "string",
      "description": "\uc0c1\uc138 \ub0b4\uc6a9 \uc911\uad6d\uc5b4 \ubc88\uc5ed (\uc790\ub3d9)"
    },
    "status": {
      "type": "string",
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "DONE"
      ],
      "description": "\uc138\ubd80 \uc5c5\ubb34 \uc9c4\ud589 \uc0c1\ud0dc"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\ub9c8\uac10\uc77c"
    },
    "assignee_name": {
      "type": "string",
      "description": "\ub2f4\ub2f9\uc790 \uc774\ub984"
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ],
      "description": "\uc6b0\uc120\uc21c\uc704"
    },
    "google_task_id": {
      "type": "string",
      "description": "\uc5f0\ub3d9\ub41c Google Tasks \ud56d\ubaa9 ID"
    },
    "google_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\ub9c8\uc9c0\ub9c9 Google Tasks \ub3d9\uae30\ud654 \uc2dc\uac01"
    }
  },
  "required": [
    "card_id",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}