{
  "name": "Notification",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc218\uc2e0\uc790 \uc18c\uc18d \ud300 ID (\ucc38\uc870\uc6a9 \u2014 \uad8c\ud55c \ud0a4\ub294 recipient_id)"
    },
    "recipient_id": {
      "type": "string",
      "description": "\uc218\uc2e0\uc790 User ID (RLS \uc2a4\ucf54\ud504 \ud0a4)"
    },
    "recipient_email": {
      "type": "string",
      "description": "\uc218\uc2e0\uc790 \uc774\uba54\uc77c (\uc774\uba54\uc77c \ubcd1\ud589 \ubc1c\uc1a1\uc6a9)"
    },
    "type": {
      "type": "string",
      "enum": [
        "card_moved",
        "card_shared",
        "chat_message",
        "quote_published",
        "settlement_due",
        "portfolio_edit_request",
        "payment_confirmed",
        "schedule_changed",
        "file_shared",
        "requirements_updated",
        "marketing_comment",
        "sample_submitted",
        "sample_feedback",
        "holiday_conflict",
        "holiday_notice",
        "reorder_due",
        "milestone_overdue",
        "qc_published",
        "qc_decision",
        "agreement_renewal",
        "monthly_report",
        "spec_sent",
        "spec_decision",
        "shipment_updated",
        "shipment_docs_missing",
        "reorder_requested",
        "dest_cost_sent",
        "dest_cost_decision",
        "dest_cost_unconfirmed",
        "factory_account_changed",
        "factory_account_verified",
        "claim_submitted",
        "claim_updated",
        "comparison_published",
        "comparison_choice",
        "landed_cost_confirmed",
        "contract_sent",
        "contract_signed",
        "contract_declined",
        "contract_expired",
        "payment_requested",
        "payment_request_canceled",
        "payment_reported",
        "payment_due",
        "payment_overdue",
        "client_approval_requested",
        "client_approval_decided",
        "quote_accepted",
        "file_review_requested",
        "file_review_decision"
      ],
      "description": "\uc54c\ub9bc \uc720\ud615"
    },
    "title": {
      "type": "string",
      "description": "\uc54c\ub9bc \uc81c\ubaa9"
    },
    "body": {
      "type": "string",
      "description": "\uc54c\ub9bc \ubcf8\ubb38"
    },
    "link": {
      "type": "string",
      "description": "\ud074\ub9ad \uc2dc \uc774\ub3d9 \uacbd\ub85c"
    },
    "task_card_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c TaskCard ID"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "\uc77d\uc74c \uc5ec\ubd80"
    }
  },
  "required": [
    "recipient_id",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.account_tier": "master"
      }
    },
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      ]
    }
  }
}
