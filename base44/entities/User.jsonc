{
  "name": "User",
  "type": "object",
  "properties": {
    "account_tier": {
      "type": "string",
      "enum": [
        "master",
        "service",
        "sub",
        "client"
      ],
      "description": "master=\uc2dc\uc2a4\ud15c \ub9c8\uc2a4\ud130, service=\ud300 \uad00\ub9ac\uc790, sub=\ud300\uc6d0, client=\uace0\uac1d\uc0ac \uacc4\uc815",
      "rls": {
        "write": {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID",
      "rls": {
        "write": {
          "user_condition": {
            "data.account_tier": "master"
          }
        }
      }
    },
    "company_id": {
      "type": "string",
      "description": "client \uacc4\uc815\uc758 \uc18c\uc18d \uace0\uac1d\uc0ac Company ID"
    },
    "service_admin_id": {
      "type": "string",
      "description": "\ud300 \uad00\ub9ac\uc790 User ID"
    },
    "team_role_id": {
      "type": "string",
      "description": "\ubc30\uc815\ub41c \ud300 \uc5ed\ud560 ID"
    },
    "team_role_name": {
      "type": "string",
      "description": "\ubc30\uc815\ub41c \ud300 \uc5ed\ud560\uba85"
    },
    "team_role": {
      "type": "string",
      "enum": [
        "manager",
        "member",
        "viewer"
      ],
      "default": "member",
      "description": "\ub808\uac70\uc2dc \ud300 \uc5ed\ud560"
    },
    "allowed_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ubc30\uc815\ub41c \uc5ed\ud560\uc5d0\uc11c \ub3d9\uae30\ud654\ub41c \uba54\ub274 \uacbd\ub85c"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\uacc4\uc815 \ud65c\uc131\ud654 \uc5ec\ubd80"
    },
    "account_label": {
      "type": "string",
      "description": "\ud68c\uc0ac/\ud300 \ub610\ub294 \uc0ac\uc6a9\uc790 \ud45c\uc2dc\uba85"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ko",
        "zh"
      ],
      "default": "ko",
      "description": "\uc0ac\uc6a9\uc790 \uae30\ubcf8 \ud45c\uc2dc \uc5b8\uc5b4"
    },
    "notification_prefs": {
      "type": "object",
      "description": "\uace0\uac1d \uba54\uc77c \uc54c\ub9bc \uc124\uc815. \ubb36\uc74c\ubcc4 { email: false } \uba74 \uadf8 \ubb36\uc74c \uba54\uc77c\uc744 \ubc1b\uc9c0 \uc54a\ub294\ub2e4 (\uacb0\uc815 \uc694\uccad\u00b7\uacb0\uc81c \uc694\uccad\u00b7\uae30\ud55c\u00b7\uacf5\uc7a5 \uacc4\uc88c \ubcc0\uacbd\uc740 \ud56d\uc0c1 \ubc1b\ub294\ub2e4). \uc571 \uc54c\ub9bc\uc740 \uadf8\ub300\ub85c"
    },
    "daily_digest_sent_for": {
      "type": "string",
      "description": "\uc9c1\uc6d0 \uc77c\uc77c \uc6b4\uc601 \uc694\uc57d\uc744 \ubcf4\ub0b8 \ud55c\uad6d \ub0a0\uc9dc (\ud558\ub8e8 \ud55c \ubc88)"
    },
    "weekly_digest_sent_for": {
      "type": "string",
      "description": "\uace0\uac1d \uc8fc\uac04 \uc694\uc57d \uba54\uc77c\uc744 \ubcf4\ub0b8 \uc8fc\uc758 \uc6d4\uc694\uc77c (\uc8fc \ud55c \ubc88)"
    }
  },
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}