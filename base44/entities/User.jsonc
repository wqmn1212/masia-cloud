{
  "name": "User",
  "type": "object",
  "properties": {
    "account_tier": {
      "type": "string",
      "enum": [
        "master",
        "service",
        "sub"
      ],
      "description": "master=\uc2dc\uc2a4\ud15c \ub9c8\uc2a4\ud130, service=\ud300 \uad00\ub9ac\uc790, sub=\ud300\uc6d0"
    },
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID"
    },
    "service_admin_id": {
      "type": "string",
      "description": "\ud300 \uad00\ub9ac\uc790 User ID"
    },
    "team_role_id": {
      "type": "string",
      "description": "\ubc30\uc815\ub41c \ud300 \uc5ed\ud560 ID"
    },
    "team_role_name": {
      "type": "string",
      "description": "\ubc30\uc815\ub41c \ud300 \uc5ed\ud560\uba85"
    },
    "team_role": {
      "type": "string",
      "enum": [
        "manager",
        "member",
        "viewer"
      ],
      "default": "member",
      "description": "\ub808\uac70\uc2dc \ud300 \uc5ed\ud560"
    },
    "allowed_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ubc30\uc815\ub41c \uc5ed\ud560\uc5d0\uc11c \ub3d9\uae30\ud654\ub41c \uba54\ub274 \uacbd\ub85c"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\uacc4\uc815 \ud65c\uc131\ud654 \uc5ec\ubd80"
    },
    "account_label": {
      "type": "string",
      "description": "\ud68c\uc0ac/\ud300 \ub610\ub294 \uc0ac\uc6a9\uc790 \ud45c\uc2dc\uba85"
    }
  },
  "rls": {
    "create": true,
    "read": {
      "$or": [
        { "id": "{{user.id}}" },
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "data.account_tier": "master" } },
        { "user_condition": { "data.account_tier": "service" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "data.account_tier": "master" } },
        { "user_condition": { "data.account_tier": "service" } }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "data.account_tier": "master" } }
      ]
    }
  }
}