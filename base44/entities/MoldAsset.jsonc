{
  "name": "MoldAsset",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID"
    },
    "card_id": {
      "type": "string",
      "description": "\ud504\ub85c\uc81d\ud2b8 \uce74\ub4dc ID"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac ID"
    },
    "factory_id": {
      "type": "string",
      "description": "\ubcf4\uad00 \uacf5\uc7a5 ID"
    },
    "factory_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "\uae08\ud615 \uc774\ub984 (\uc608: \ubcf8\uccb4 \uc0c1\ud310 \uae08\ud615)"
    },
    "part_name": {
      "type": "string",
      "description": "\ubd80\ud488\uba85"
    },
    "cavity": {
      "type": "number",
      "description": "\uce90\ube44\ud2f0 \uc218"
    },
    "material": {
      "type": "string",
      "description": "\uae08\ud615 \uac15\uc7ac (\uc608: P20, NAK80)"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "description": "\uae08\ud615 \uc0ac\uc9c4"
    },
    "ownership": {
      "type": "string",
      "description": "\uc18c\uc720\uc790",
      "enum": [
        "CLIENT",
        "AEGIS",
        "FACTORY"
      ],
      "default": "CLIENT"
    },
    "ownership_confirmed": {
      "type": "boolean",
      "description": "\uacf5\uc7a5\uc774 \uc11c\uba85\ud55c \uae08\ud615 \uc18c\uc720 \ud655\uc778\uc11c\ub97c \ubc1b\uc558\ub294\uc9c0"
    },
    "ownership_doc_id": {
      "type": "string",
      "description": "\uae08\ud615 \uc18c\uc720 \ud655\uc778\uc11c CardAttachment ID"
    },
    "ownership_doc_name": {
      "type": "string",
      "description": "\uae08\ud615 \uc18c\uc720 \ud655\uc778\uc11c \ud30c\uc77c\uba85"
    },
    "fee_amount": {
      "type": "number",
      "description": "\uae08\ud615\ube44"
    },
    "fee_currency": {
      "type": "string",
      "enum": [
        "CNY",
        "USD",
        "KRW"
      ]
    },
    "fee_paid_at": {
      "type": "string",
      "description": "\uae08\ud615\ube44 \uc9c0\uae09\uc77c YYYY-MM-DD"
    },
    "return_terms": {
      "type": "string",
      "description": "\ubc18\ud658 \uc870\uac74 (\uc608: \uac70\ub798 \uc885\ub8cc \uc2dc 30\uc77c \uc548\uc5d0 \uace0\uac1d \uc9c0\uc815 \uc7a5\uc18c\ub85c \ubc18\ud658, \uc6b4\uc1a1\ube44 \uace0\uac1d \ubd80\ub2f4)"
    },
    "shot_count": {
      "type": "number",
      "description": "\ub204\uc801 \uc0ac\uc6a9 \ud69f\uc218(\uc1fc\ud2b8)"
    },
    "expected_life_shots": {
      "type": "number",
      "description": "\uc608\uc0c1 \uc218\uba85(\uc1fc\ud2b8)"
    },
    "status": {
      "type": "string",
      "description": "\uc0ac\uc6a9 \uc911 / \ub300\uae30 / \ubc18\ud658 / \ud3d0\uae30",
      "enum": [
        "IN_USE",
        "IDLE",
        "RETURNED",
        "SCRAPPED"
      ],
      "default": "IN_USE"
    },
    "last_checked_at": {
      "type": "string",
      "description": "\ub9c8\uc9c0\ub9c9 \uc2e4\ubb3c \ud655\uc778\uc77c YYYY-MM-DD"
    },
    "note": {
      "type": "string",
      "description": "\ub0b4\ubd80 \uba54\ubaa8"
    }
  },
  "required": [
    "card_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}
