{
  "name": "ProtoMeasurement",
  "type": "object",
  "description": "3D \uac80\ud1a0 \uce21\uc815 \uae30\ub85d: \ud654\uba74\uc5d0\uc11c \ucc0d\uc740 \ub450 \uc810\uc758 \uac70\ub9ac\u00b7\uc138 \uc810\uc758 \uac01\ub3c4\uc640 \uc124\uacc4\uac12\uc744 \ube44\uad50\ud574 \uc77c\uce58\u00b7\ucc28\uc774\u00b7\uc644\ub8cc\ub97c \ub0a8\uae34\ub2e4. \uc810\uc740 \ubaa8\ub378 \uc88c\ud45c(mm)\ub85c \uc800\uc7a5\ud574 \ub2e4\uc2dc \uc5f4\uc5b4\ub3c4 \uac19\uc740 \uc790\ub9ac\uc5d0 \ud45c\uc2dc\ub41c\ub2e4",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID (\ub370\uc774\ud130 \uaca9\ub9ac \ud0a4)"
    },
    "project_id": {
      "type": "string"
    },
    "model_file_id": {
      "type": "string",
      "description": "\uce21\uc815\ud55c 3D \ud30c\uc77c (ProtoProject.files.id)"
    },
    "model_file_name": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "\uce21\uc815 \uc774\ub984 (\uc608: \ucf00\uc774\uc2a4 \ud3ed)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "DISTANCE",
        "ANGLE"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "description": "DISTANCE = \ub450 \uc810 \uac70\ub9ac, ANGLE = \uc138 \uc810 \uac01\ub3c4(\ub450 \ubc88\uc9f8\uac00 \uaf2d\uc9d3\uc810)"
    },
    "points": {
      "type": "array",
      "description": "\ubaa8\ub378 \uc88c\ud45c\uacc4\uc758 \uc810 {x,y,z} (mm)",
      "items": {
        "type": "object"
      }
    },
    "value": {
      "type": "number",
      "description": "\uce21\uc815\uac12 (mm \ub610\ub294 \ub3c4)"
    },
    "unit": {
      "type": "string",
      "enum": [
        "mm",
        "deg"
      ],
      "enumColors": [
        "gray",
        "gray"
      ]
    },
    "design_value": {
      "type": "number",
      "description": "\uc124\uacc4\uac12 (mm \ub610\ub294 \ub3c4). \ube44\uc5b4 \uc788\uc73c\uba74 \ub300\uc870\ud558\uc9c0 \uc54a\ub294\ub2e4"
    },
    "tolerance": {
      "type": "number",
      "description": "\ud5c8\uc6a9 \uc624\ucc28 (\u00b1)"
    },
    "difference": {
      "type": "number",
      "description": "\uce21\uc815\uac12 - \uc124\uacc4\uac12"
    },
    "status": {
      "type": "string",
      "enum": [
        "MEASURED",
        "DIFF",
        "MATCH",
        "DONE"
      ],
      "enumColors": [
        "gray",
        "red",
        "yellow",
        "green"
      ],
      "default": "MEASURED",
      "description": "MEASURED = \uce21\uc815\ub9cc, DIFF = \ucc28\uc774(\uc218\uc815 \ud544\uc694), MATCH = \uc77c\uce58, DONE = \ud655\uc778 \uc644\ub8cc"
    },
    "part_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\uce21\uc815\uc5d0 \ucc0d\ud78c \ubd80\ud488 \uc774\ub984"
    },
    "note": {
      "type": "string"
    },
    "done_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uc644\ub8cc\ub85c \ud45c\uc2dc\ud55c \uc2dc\uac01"
    },
    "done_by_name": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "project_id",
    "kind",
    "value",
    "unit"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}