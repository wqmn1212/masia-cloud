{
  "name": "QualityClaim",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\uc18c\uc18d \ud300 ID"
    },
    "card_id": {
      "type": "string",
      "description": "\ud504\ub85c\uc81d\ud2b8 \uce74\ub4dc ID"
    },
    "client_id": {
      "type": "string",
      "description": "\uace0\uac1d\uc0ac ID"
    },
    "title": {
      "type": "string",
      "description": "\ubd88\ub7c9 \uc694\uc57d"
    },
    "title_cn": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "\ubd88\ub7c9 \ub0b4\uc6a9 (\uace0\uac1d \uc791\uc131)"
    },
    "description_cn": {
      "type": "string",
      "description": "\uc911\uad6d\uc5b4 \ubc88\uc5ed (\uacf5\uc7a5 \uc804\ub2ec\uc6a9)"
    },
    "defect_qty": {
      "type": "number",
      "description": "\ubd88\ub7c9 \uc218\ub7c9"
    },
    "received_qty": {
      "type": "number",
      "description": "\ubc1b\uc740 \uc218\ub7c9"
    },
    "lot_note": {
      "type": "string",
      "description": "\uc785\uace0\uc77c\u00b7\ub85c\ud2b8\u00b7\ubc15\uc2a4 \ubc88\ud638 \ub4f1"
    },
    "photo_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ubd88\ub7c9 \uc0ac\uc9c4 CardAttachment ID"
    },
    "status": {
      "type": "string",
      "description": "\uc811\uc218 \u2192 \ud655\uc778 \uc911 \u2192 \uacf5\uc7a5 \ud655\uc778 \u2192 \ucc98\ub9ac \uc644\ub8cc / \ubc18\ub824",
      "enum": [
        "SUBMITTED",
        "REVIEWING",
        "FACTORY_CONFIRMED",
        "RESOLVED",
        "REJECTED"
      ],
      "default": "SUBMITTED"
    },
    "resolution": {
      "type": "string",
      "description": "\ucc98\ub9ac \ubc29\ubc95 (PENDING \ubbf8\uc815)",
      "enum": [
        "PENDING",
        "REWORK",
        "REPLACE",
        "REFUND",
        "DISCOUNT",
        "NONE"
      ]
    },
    "client_message": {
      "type": "string",
      "description": "\uace0\uac1d\uc5d0\uac8c \ubcf4\uc774\ub294 \ucc98\ub9ac \uc548\ub0b4"
    },
    "factory_response": {
      "type": "string",
      "description": "\uacf5\uc7a5 \ud68c\uc2e0 (\ub0b4\ubd80)"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "description": "\uc0c1\ud0dc \ubcc0\uacbd \uae30\ub85d",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "card_id",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.account_tier": "master"
      }
    }
  }
}
