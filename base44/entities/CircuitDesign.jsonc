{
  "name": "CircuitDesign",
  "type": "object",
  "description": "회로 시뮬레이터에 저장한 회로도 (부품 배치·값, 계산 시간 간격). 시제품에 연결할 수 있다",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "소속 팀 ID (데이터 격리 키)"
    },
    "title": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "연결한 시제품 (ProtoProject.id, 선택)"
    },
    "project_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "circuit": {
      "type": "object",
      "additionalProperties": true,
      "description": "{version, parts:[{id,type,x1,y1,x2,y2,props}], dt}"
    },
    "part_count": {
      "type": "number"
    },
    "created_by_name": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tenant_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.account_tier": "master"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            },
            {
              "user_condition": {
                "data.account_tier": "sub"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.account_tier": "service"
                  }
                },
                {
                  "user_condition": {
                    "data.account_tier": "sub"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.account_tier": "master"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.account_tier": "service"
              }
            }
          ]
        }
      ]
    }
  }
}
