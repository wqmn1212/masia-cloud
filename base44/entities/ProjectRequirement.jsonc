{
  "name": "ProjectRequirement",
  "type": "object",
  "properties": {
    "ledger_id": {
      "type": "string",
      "description": "\uc5f0\ub3d9\ub41c \uc815\uc0b0 \uc6d0\uc7a5 ID"
    },
    "project_label": {
      "type": "string",
      "description": "\ud504\ub85c\uc81d\ud2b8 \ud45c\uc2dc\uba85 (\uacf5\uc7a5\uba85 + \uace0\uac1d\uc0ac\uba85)"
    },
    "title": {
      "type": "string",
      "description": "\uc694\uad6c\uc0ac\ud56d \uc694\uc57d \uc81c\ubaa9"
    },
    "description_kr": {
      "type": "string",
      "description": "\ud55c\uad6d \uace0\uac1d\uc0ac \uc791\uc131 \ub0b4\uc6a9 (\ud55c\uad6d\uc5b4)"
    },
    "description_cn": {
      "type": "string",
      "description": "AI \uae30\uacc4 \ub9e4\ud551 \ubc88\uc5ed\ub41c \uc911\uad6d\uc5b4 \uae30\uc220 \uc9c0\uc2dc\uc11c"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "COMPLETED",
        "VERIFIED"
      ],
      "description": "4\ub2e8\uacc4 \uc0c1\ud0dc\uba38\uc2e0"
    },
    "evidence_file_url": {
      "type": "string",
      "description": "\uc5d0\uc774\uc804\ud2b8\uac00 \ud604\uc7a5 \ucd2c\uc601 \uc5c5\ub85c\ub4dc\ud55c \uc2e4\ubb3c \uc99d\ube59 \ud30c\uc77c URL"
    },
    "agent_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uc5d0\uc774\uc804\ud2b8 \uacf5\uc7a5 \uc2e4\uc0ac \ud655\uc778 \ud0c0\uc784\uc2a4\ud0ec\ud504"
    },
    "machine_category": {
      "type": "string",
      "enum": [
        "DRIP_BAG",
        "SLEEVE",
        "DESKTOP_LABELER",
        "TUBE_SEALER"
      ],
      "description": "\uad00\ub828 \uc7a5\ube44 \uce74\ud14c\uace0\ub9ac"
    }
  },
  "required": [
    "title",
    "description_kr",
    "status"
  ],
  "rls": {
    "create": { "$or": [
      { "user_condition": { "data.account_tier": "master" } },
      { "user_condition": { "data.account_tier": "service" } },
      { "user_condition": { "data.account_tier": "sub" } }
    ] },
    "read": { "$or": [
      { "user_condition": { "data.account_tier": "master" } },
      { "user_condition": { "data.account_tier": "service" } },
      { "user_condition": { "data.account_tier": "sub" } }
    ] },
    "update": { "$or": [
      { "user_condition": { "data.account_tier": "master" } },
      { "user_condition": { "data.account_tier": "service" } },
      { "user_condition": { "data.account_tier": "sub" } }
    ] },
    "delete": { "$or": [
      { "user_condition": { "data.account_tier": "master" } },
      { "user_condition": { "data.account_tier": "service" } }
    ] }
  }
}