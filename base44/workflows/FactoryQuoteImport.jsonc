{
  "name": "\uacf5\uc7a5 \uacac\uc801\uc11c \uc790\ub3d9 \uc77d\uae30",
  "description": "\uacf5\uc7a5\uc774 \uc5c5\ub85c\ub4dc \ub9c1\ud06c\ub85c \uacac\uc801\uc11c\ub97c \uc62c\ub9ac\uba74 \uc77d\uc5b4\uc11c \uce74\ub4dc\uc5d0 \uacac\uc801 \ucd08\uc548(\uacf5\uc7a5 \uc6d0\uac00 \uadf8\ub300\ub85c)\uc744 \ub9cc\ub4e4\uace0 \ub2f4\ub2f9\uc790\uc5d0\uac8c \uc54c\ub9bd\ub2c8\ub2e4.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "factory_quote_import",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "import_quote": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importFactoryQuote",
            "args": {
              "request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\uacac\uc801\uc11c \uc77d\uae30\u00b7\ucd08\uc548 \ub9cc\ub4e4\uae30",
            "description": "\uacf5\uc7a5 \uc5c5\ub85c\ub4dc \uacac\uc801\uc11c \u2192 \uacac\uc801 \ucd08\uc548"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": "${ .trigger.data.quote_import_pending == true }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FactoryRequest"
    }
  }
}
