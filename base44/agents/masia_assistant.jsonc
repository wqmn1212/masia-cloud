    {
      "function_name": "assistantCreateQuotation",
      "description": "\uc2b9\uc778\ub41c \uc5d1\uc140 \uacac\uc801 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0c8 \uacac\uc801(DRAFT)\uc73c\ub85c \ub4f1\ub85d\ud569\ub2c8\ub2e4. card_id, factory_name, product_name, model_name, quote_title, incoterms, logistics_cost, quote_options[{option_name, specification, quantity, unit_price, currency}], line_items \ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c4\u00b7\uc218\uc218\ub8cc\u00b7\ucd5c\uc885\uac00\ub294 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    },
    {
      "function_name": "assistantDestCost",
      "description": "\uad00\uc138\uc0ac\u00b7\ud3ec\uc6cc\ub354 \uc815\uc0b0\uc11c\ub85c \uc120\uc801\uc758 \ud55c\uad6d \ub3c4\ucc29 \uc2e4\uc81c \ube44\uc6a9\uc744 \uae30\ub85d\ud569\ub2c8\ub2e4. action=find(\uc2e4\uc81c \ube44\uc6a9\uc774 \ube48 \ub3c4\ucc29 \uc120\uc801 \ucc3e\uae30, card_query) \u00b7 parse(file_url, shipment_id? \u2192 \ubbf8\ub9ac\ubcf4\uae30\ub9cc, \uc800\uc7a5 \uc548 \ud568) \u00b7 apply(shipment_id, actual_ex_vat, actual_vat, file_url, file_name, client_note?, overwrite? \u2192 \uc0ac\uc6a9\uc790 \uc2b9\uc778 \ub4a4\uc5d0\ub9cc)."
    },
    {
      "function_name": "assistantStatus",
      "description": "\uc804\uc790\uc11c\uba85\u00b7\uacac\uc801 \ube44\uad50\ud45c\u00b7\ub3c4\ucc29 \uc6d0\uac00 \ud604\ud669\uc744 \uc77d\uae30\ub9cc \ud569\ub2c8\ub2e4. topic=all|signatures|comparisons|costs, card_query \ub85c \uc881\ud799\ub2c8\ub2e4."
    },
    {
      "function_name": "assistantDraft",
      "description": "\ucd08\uc548\ub9cc \ub9cc\ub4ed\ub2c8\ub2e4(\uace0\uac1d\uc5d0\uac8c \ub098\uac00\uc9c0 \uc54a\uc74c). kind=comparison(card_id, quotation_ids?) \u2192 \uacac\uc801 \ube44\uad50\ud45c \ucd08\uc548 \u00b7 kind=contract(quotation_id \ub610\ub294 service_agreement_id, contract_type?) \u2192 \uacc4\uc57d\uc11c \ucd08\uc548."
    }
  ],
